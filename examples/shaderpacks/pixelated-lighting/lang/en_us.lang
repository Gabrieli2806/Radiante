# Pixelated Lighting: its own settings, groups, descriptions and presets; the rest of the names come from radiante-pt.
render_pipeline.module.ray_tracing.attribute.pixel_light_texels=Texels per Block
render_pipeline.module.ray_tracing.attribute.pixel_light_shadows=Pixelated Shadows
render_pipeline.module.ray_tracing.attribute.pixel_light_reflections=Pixelated Reflections
render_pipeline.module.ray_tracing.attribute.pixel_light_palette=Retro Palette
render_pipeline.module.ray_tracing.attribute.pixel_light_dither=Dither

pixel_light.group.light=Pixels
pixel_light.group.palette=Retro Palette

pixel_light.desc.texels=Shadows and reflections land per texel, at most this many per block side. 16 is the texture's own pixels; lower is chunkier; 0 turns it off.
pixel_light.desc.shadows=Shadow edges follow the texture's pixels: each texel is in shadow or not. The light itself stays smooth.
pixel_light.desc.reflections=Reflections, water's included, come out in solid squares, one per texel. What is seen through water and glass stays sharp.
pixel_light.desc.palette=Snaps each colour channel to this many levels, like an old console. 0 keeps the natural colours.
pixel_light.desc.dither=Checkered steps between neighbouring palette levels instead of bands. 0 turns it off.

pixel_light.preset.pixelated=Pixelated Lighting
pixel_light.preset.pixelated.desc=The pack's own look: shadows and reflections in the texture's pixels, natural colours.
pixel_light.preset.chunky=Chunky
pixel_light.preset.chunky.desc=Shadows and reflections in squares of two texture pixels.
pixel_light.preset.retro=Retro
pixel_light.preset.retro.desc=Pixelated shadows and reflections and a twelve-level palette with dither.
