{
    "radiante": {
        "display_name": "Mellow (Radiante port)",
        "version": "0.3.0",
        "author": "G2806, from Mellow by TheCMK",
        "license": "GPL-3.0 (Mellow parts and images MIT, LICENSE-MELLOW)",
        "description": "The look of the Iris pack Mellow by TheCMK on Radiante's path-traced light: its sky colours, clouds and their shadows, stars, sun colour, fog, water and grade. Mellow's code and images are MIT-licensed.",
        "api_version": 0,
        "extends": "radiante-pt@1"
    },
    "attributes": [
        {
            "name": "render_pipeline.module.ray_tracing.attribute.mellow_sky",
            "type": "float_range:0.0-1.0",
            "default_value": "1.0",
            "define": "MELLOW_SKY"
        },
        {
            "name": "render_pipeline.module.ray_tracing.attribute.mellow_cloud_style",
            "type": "int_range:0-2",
            "default_value": "1",
            "define": "MELLOW_CLOUD_STYLE"
        },
        {
            "name": "render_pipeline.module.ray_tracing.attribute.mellow_cloud_amount",
            "type": "int_range:12-26",
            "default_value": "22",
            "define": "MELLOW_CLOUD_AMOUNT"
        },
        {
            "name": "render_pipeline.module.ray_tracing.attribute.mellow_cloud_opacity",
            "type": "float_range:0.0-0.38",
            "default_value": "0.24",
            "define": "MELLOW_CLOUD_OPACITY"
        },
        {
            "name": "render_pipeline.module.ray_tracing.attribute.mellow_cloud_speed",
            "type": "int_range:0-6",
            "default_value": "2",
            "define": "MELLOW_CLOUD_SPEED"
        },
        {
            "name": "render_pipeline.module.ray_tracing.attribute.mellow_cloud_shadows",
            "type": "float_range:0.0-1.0",
            "default_value": "0.6",
            "define": "MELLOW_CLOUD_SHADOWS"
        },
        {
            "name": "render_pipeline.module.ray_tracing.attribute.mellow_stars",
            "type": "float_range:0.0-2.0",
            "default_value": "0.5",
            "define": "MELLOW_STARS"
        },
        {
            "name": "render_pipeline.module.ray_tracing.attribute.mellow_aurora",
            "type": "float_range:0.0-0.5",
            "default_value": "0.0",
            "define": "MELLOW_AURORA"
        },
        {
            "name": "render_pipeline.module.ray_tracing.attribute.mellow_sun_tint",
            "type": "float_range:0.0-1.0",
            "default_value": "0.7",
            "define": "MELLOW_SUN_TINT"
        },
        {
            "name": "render_pipeline.module.ray_tracing.attribute.mellow_fog",
            "type": "float_range:0.0-1.0",
            "default_value": "0.25",
            "define": "MELLOW_FOG"
        },
        {
            "name": "render_pipeline.module.ray_tracing.attribute.mellow_water",
            "type": "float_range:0.0-1.0",
            "default_value": "0.75",
            "define": "MELLOW_WATER"
        },
        {
            "name": "render_pipeline.module.ray_tracing.attribute.mellow_vibrance",
            "type": "float_range:0.0-2.0",
            "default_value": "1.14",
            "define": "MELLOW_VIBRANCE"
        },
        {
            "name": "render_pipeline.module.ray_tracing.attribute.mellow_saturation",
            "type": "float_range:0.0-2.0",
            "default_value": "1.0",
            "define": "MELLOW_SATURATION"
        },
        {
            "name": "render_pipeline.module.ray_tracing.attribute.mellow_contrast",
            "type": "float_range:0.5-1.5",
            "default_value": "0.97",
            "define": "MELLOW_CONTRAST"
        },
        {
            "name": "render_pipeline.module.ray_tracing.attribute.mellow_lut",
            "type": "int_range:0-3",
            "default_value": "0",
            "define": "MELLOW_LUT"
        },
        {
            "name": "render_pipeline.module.ray_tracing.attribute.cloud_mode",
            "default_value": "render_pipeline.module.ray_tracing.attribute.cloud_mode.off"
        }
    ],
    "textures": [
        {
            "name": "mellow_cloud_noise",
            "type": "file",
            "path": "textures/mellow_cloud_noise.png",
            "sampled_binding": 48,
            "filter": "linear",
            "address_mode": "repeat"
        },
        {
            "name": "mellow_worley_perlin",
            "type": "file",
            "path": "textures/mellow_worley_perlin.raw",
            "dimension": "3d",
            "format": "R8_UNORM",
            "width": 64,
            "height": 64,
            "depth": 64,
            "sampled_binding": 49,
            "filter": "linear",
            "address_mode": "repeat"
        },
        {
            "name": "mellow_lut_vintage",
            "type": "file",
            "path": "textures/mellow_lut_vintage.png",
            "sampled_binding": 50,
            "filter": "linear",
            "address_mode": "clamp_to_edge"
        },
        {
            "name": "mellow_lut_mellow",
            "type": "file",
            "path": "textures/mellow_lut_mellow.png",
            "sampled_binding": 51,
            "filter": "linear",
            "address_mode": "clamp_to_edge"
        },
        {
            "name": "mellow_lut_punchy",
            "type": "file",
            "path": "textures/mellow_lut_punchy.png",
            "sampled_binding": 52,
            "filter": "linear",
            "address_mode": "clamp_to_edge"
        }
    ],
    "execution_post": {
        "global_variables": [
            {
                "RADIANTE_HOOK_POST_GRADE": true
            }
        ]
    }
}
