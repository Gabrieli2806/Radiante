#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_control_flow_attributes : require

// SHaRC resolve pass: one invocation per hash-table entry folds the radiance accumulated this frame into the
// resolved cache that the query raygen reads, and evicts entries that went unused for too long. All the work is
// done by the SHaRC library; this file only builds its parameters from the config buffer the C++ side fills.
// Without USE_SHARC the shader compiles to an empty dispatch.

#ifndef USE_SHARC
#    define USE_SHARC 0
#endif

#if USE_SHARC
#    extension GL_EXT_shader_atomic_int64 : require
#    extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#    extension GL_EXT_shader_16bit_storage : enable
#    define SHARC_ENABLE_GLSL 1
#    define SHARC_ENABLE_64_BIT_ATOMICS 1
#    ifndef SHARC_UPDATE
#        define SHARC_UPDATE 0
#    endif
#    ifndef SHARC_QUERY
#        define SHARC_QUERY 0
#    endif

#    include "extern/sharc/include/SharcGlsl.h"
#    include "extern/sharc/include/SharcCommon.h"
#endif

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Must match the C++ upload layout field for field (buffer addresses are passed as uvec2 pairs).
struct SharcConfig {
    uvec2 hashEntriesAddress;
    uvec2 lockAddress;
    uvec2 accumulationAddress;
    uvec2 resolvedAddress;
    vec4 cameraPosition;
    vec4 cameraPositionPrev;
    float sceneScale;
    float radianceScale;
    uint accumulationFrameNum;
    uint staleFrameNumMax;
    uint capacity;
    uint frameIndex;
    uint enableAntiFireflyFilter;
    uint useLockBuffer;
    uint debugMode;
    uint updateDownsampleFactor;
};

layout(set = 4, binding = 0) readonly buffer SharcConfigBuffer {
    SharcConfig sharcConfig;
};

// Translates the config buffer into the library's parameter block (hash map, grid and buffers).
SharcParameters makeSharcParameters() {
    SharcParameters params;

    params.gridParameters.cameraPosition = sharcConfig.cameraPosition.xyz;
    params.gridParameters.logarithmBase = SHARC_GRID_LOGARITHM_BASE;
    params.gridParameters.sceneScale = sharcConfig.sceneScale;
    params.gridParameters.levelBias = SHARC_GRID_LEVEL_BIAS;

    params.hashMapData.capacity = sharcConfig.capacity;
    params.hashMapData.hashEntriesBuffer = RWStructuredBuffer_uint64_t(sharcConfig.hashEntriesAddress);
#if !HASH_GRID_ENABLE_64_BIT_ATOMICS
    // Only needed when the hash map has to fall back to a lock buffer instead of 64-bit atomics.
    params.hashMapData.lockBuffer = RWStructuredBuffer_uint(sharcConfig.lockAddress);
#endif

    params.radianceScale = sharcConfig.radianceScale;
    params.enableAntiFireflyFilter = sharcConfig.enableAntiFireflyFilter != 0;
    params.accumulationBuffer = RWStructuredBuffer_SharcAccumulationData(sharcConfig.accumulationAddress);
    params.resolvedBuffer = RWStructuredBuffer_SharcPackedData(sharcConfig.resolvedAddress);
    return params;
}

void main() {
#if USE_SHARC
    uint entry = gl_GlobalInvocationID.x;
    // The dispatch is rounded up to the workgroup size; the tail invocations have no entry.
    if (entry >= sharcConfig.capacity) { return; }

    SharcResolveParameters resolve;
    resolve.cameraPositionPrev = sharcConfig.cameraPositionPrev.xyz;
    resolve.accumulationFrameNum = sharcConfig.accumulationFrameNum;
    resolve.staleFrameNumMax = sharcConfig.staleFrameNumMax;
    resolve.frameIndex = sharcConfig.frameIndex;

    SharcResolveEntry(entry, makeSharcParameters(), resolve);
#endif
}
