#version 460
#extension GL_GOOGLE_include_directive : require

// Runs before the world pass: the fog's two world grids (common/froxel_fog.glsl) follow the camera. A texel whose
// world cell changed since last frame (the camera crossed into another cell, and the texel wrapped round to the
// grid's other side) holds nothing of its new cell yet: the fine grid's take the coarse grid's light there, the
// coarse grid's keep what they held, and both count no looks, so the world pass's first look replaces it whole.

#include "common/shared.hpp"

layout(set = 2, binding = 0) uniform WorldUniform {
    WorldUBO worldUBO;
};
layout(set = 2, binding = 1) uniform LastWorldUniform {
    WorldUBO lastWorldUBO;
};
layout(set = 2, binding = 2) uniform SkyUniform {
    SkyUBO skyUBO;
};

#include "common/froxel_fog.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 5, binding = 40, rgba16f) uniform image3D fogSunNearImage;
layout(set = 5, binding = 41, rgba16f) uniform image3D fogBlockNearImage;
layout(set = 5, binding = 49, rgba16f) uniform image3D fogBlockFarImage;
layout(set = 5, binding = 46, rgba16f) uniform readonly image3D fogSunFarImage;

// The coarse grid's light at a point (camera-relative), trilinear by hand. Only the fine grid's edge asks, well
// inside the coarse grid, where none of its own texels are being reset.
vec4 farLightAt(vec3 position) {
    vec3 fraction;
    ivec3 cameraCell = fogVolumeCameraCell(worldUBO.cameraPos.xyz, 1, fraction);
    vec3 coordinate = clamp(fraction + position / FOG_VOLUME_FAR_CELL, vec3(-FOG_VOLUME_EXTENT / 2) + 0.5,
                            vec3(FOG_VOLUME_EXTENT / 2) - 0.5) - 0.5;
    ivec3 base = ivec3(floor(coordinate));
    vec3 weight = coordinate - vec3(base);
    vec4 sum = vec4(0.0);
    for (int corner = 0; corner < 8; corner++) {
        ivec3 offset = ivec3(corner & 1, (corner >> 1) & 1, corner >> 2);
        vec3 weight3 = mix(vec3(1.0) - weight, weight, vec3(offset));
        vec4 value = imageLoad(fogSunFarImage, fogVolumeTexel(cameraCell + base + offset));
        if (any(isnan(value)) || any(isinf(value))) { value = vec4(0.0); }
        sum += value * (weight3.x * weight3.y * weight3.z);
    }
    return sum;
}

void main() {
    ivec3 texel = ivec3(gl_GlobalInvocationID.xyz);
    int cascade = texel.z / FOG_VOLUME_EXTENT.z;
    texel.z -= cascade * FOG_VOLUME_EXTENT.z;
    if (cascade > 1 || any(greaterThanEqual(texel, FOG_VOLUME_EXTENT))) { return; }
    vec3 fraction;
    vec3 previousFraction;
    ivec3 cameraCell = fogVolumeCameraCell(worldUBO.cameraPos.xyz, cascade, fraction);
    ivec3 previousCameraCell = fogVolumeCameraCell(lastWorldUBO.cameraPos.xyz, cascade, previousFraction);
    ivec3 cell = fogVolumeCellOfTexel(texel, cameraCell);
    if (worldUBO.skyType == lastWorldUBO.skyType && cell == fogVolumeCellOfTexel(texel, previousCameraCell)) {
        return;
    }
    if (cascade == 0) {
        vec3 centre = (vec3(cell - cameraCell) + 0.5 - fraction) * FOG_VOLUME_NEAR_CELL;
        imageStore(fogSunNearImage, texel, max(farLightAt(centre), vec4(0.0)));
        imageStore(fogBlockNearImage, texel, vec4(0.0));
    } else {
        imageStore(fogBlockFarImage, texel, vec4(0.0));
    }
}
