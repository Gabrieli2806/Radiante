#version 460
#extension GL_GOOGLE_include_directive : require

// Runs after the world pass: each pixel's march through the volumetric fog's world grids (common/fog_march.glsl),
// folded into its radiance and its composed fog as the world pass folds the per-pixel march's (world.rgen). The world
// pass left what the march needs in fogMarchRecordImage.

#include "common/shared.hpp"

layout(set = 2, binding = 0) uniform WorldUniform {
    WorldUBO worldUBO;
};
layout(set = 2, binding = 1) uniform LastWorldUniform {
    WorldUBO lastWorldUBO;
};
layout(set = 2, binding = 2) uniform SkyUniform {
    SkyUBO skyUBO;
};

#ifndef VPT_VOLUMETRIC_LIGHT_SCATTERING_STRENGTH
#    define VPT_VOLUMETRIC_LIGHT_SCATTERING_STRENGTH 2.75
#endif
#ifndef VPT_BIOME_FOG_SCATTERING
#    define VPT_BIOME_FOG_SCATTERING 0.4
#endif
#ifndef VPT_BIOME_FOG_FORWARD
#    define VPT_BIOME_FOG_FORWARD 0.75
#endif
#ifndef VPT_VOLUMETRIC_LIGHT_LUMINANCE_LIMIT
#    define VPT_VOLUMETRIC_LIGHT_LUMINANCE_LIMIT 4.0
#endif
#ifndef VPT_ATMOSPHERE_MIE_G
#    define VPT_ATMOSPHERE_MIE_G 0.76
#endif

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 5, binding = 2) uniform samplerCube skyFull;
layout(set = 3, binding = 0, rgba16f) uniform image2D outputImage;
layout(set = 3, binding = 13, rgba16f) uniform image2D fogImage;
layout(set = 3, binding = 15, rgba16f) uniform image2D fogTransmissionImage;
layout(set = 5, binding = 50, rgba32ui) uniform readonly uimage2D fogMarchRecordImage;

bool finiteFloat(float value) {
    return !isnan(value) && !isinf(value);
}

bool finiteVec3(vec3 value) {
    return !any(isnan(value)) && !any(isinf(value));
}

#include "common/celestial.glsl"
#include "hooks/fog.glsl"
#include "common/fog_medium.glsl"
#include "common/froxel_fog.glsl"
#include "common/fog_march.glsl"

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(pixel, size))) { return; }
    uvec4 record = imageLoad(fogMarchRecordImage, pixel);
    if (record.x == 0u) { return; }
    float distance = uintBitsToFloat(record.x);
    float biomeReach = uintBitsToFloat(record.y);
    vec3 glassTint = unpackUnorm4x8(record.z).rgb;
    bool hitSky = (record.w & 1u) != 0u;
    bool transparentSplit = (record.w & 2u) != 0u;

    // The primary ray as the world pass made it: the pixel's centre with this frame's jitter.
    vec2 ndc = (vec2(pixel) + 0.5 + worldUBO.cameraJitter) / vec2(size) * 2.0 - 1.0;
    vec4 viewNear = worldUBO.cameraProjMatInv * vec4(ndc, 0.0, 1.0);
    viewNear /= viewNear.w;
    vec3 origin = vec3(worldUBO.cameraEffectedViewMatInv * vec4(0.0, 0.0, 0.0, 1.0));
    vec3 rayDir = normalize(vec3(worldUBO.cameraEffectedViewMatInv * vec4(viewNear.xyz, 0.0)));

    vec3 transmittance;
    vec3 light;
    froxelFog(origin, rayDir, pixel, distance, biomeReach, hitSky, transmittance, light);
    light *= glassTint;

    vec4 radiance = imageLoad(outputImage, pixel);
    imageStore(outputImage, pixel, vec4(radiance.rgb * transmittance + light, radiance.a));
    vec4 fog = imageLoad(fogImage, pixel);
    vec3 additive = fog.rgb;
    float composed = fog.a;
#if defined(VPT_BEDROCK_ORIGINAL) && VPT_BEDROCK_ORIGINAL != 0 && VPT_BEDROCK_FOG != 0
    imageStore(fogTransmissionImage, pixel, vec4(transmittance * (composed < 0.0 ? 1.0 : composed), 1.0));
    additive = (composed < 0.0 ? vec3(0.0) : additive * transmittance) + light;
    // -1 means no fog; -2 explicitly selects RGB transmission in compose, preserving legacy packs.
    imageStore(fogImage, pixel, vec4(additive, -2.0));
#else
    if (transparentSplit) { return; }
    // Folded into whatever fog is already composed (the biome haze) rather than replacing it.
    float volumetric = clamp(volumetricLightLuminance(transmittance), 0.0, 1.0);
    if (composed < 0.0) {
        imageStore(fogImage, pixel, vec4(light, volumetric));
    } else {
        imageStore(fogImage, pixel, vec4(additive * volumetric + light, composed * volumetric));
    }
#endif
}
