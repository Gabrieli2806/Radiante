#version 460
#extension GL_GOOGLE_include_directive : require

// Integrates this frame's froxel grid front to back (see common/froxel_fog.glsl): for every cell, the light scattered
// in between the camera and the cell's far edge, and the transmittance over that stretch.

#include "common/shared.hpp"

layout(set = 2, binding = 0) uniform WorldUniform {
    WorldUBO worldUBO;
};
layout(set = 2, binding = 1) uniform LastWorldUniform {
    WorldUBO lastWorldUBO;
};
layout(set = 2, binding = 2) uniform SkyUniform {
    SkyUBO skyUBO;
};

#include "common/froxel_fog.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 5, binding = 40, rgba16f) uniform readonly image3D froxelLightImage;
layout(set = 5, binding = 41, rgba16f) uniform writeonly image3D froxelIntegralImage;
layout(set = 5, binding = 46, rgba16f) uniform writeonly image3D froxelTransmissionImage;

// The cells' light filtered over their neighbours in the slice, a 3x3 tent (1 2 1). Each cell sees the sun through one
// shadow ray every fourth frame, in or out at that point: where a shaft's edge crosses a cell (a window frame, a
// branch) the cell's average is still settling, and cell by cell those averages showed as blotches of light the size
// of a cell that slid with the view as the camera moved. The grid itself keeps the unfiltered light, so the filter
// does not compound over frames through the history; only what the pixels read is softened, by about a cell.
vec3 filteredFroxelLight(ivec2 coordinate, int layer) {
    vec3 sum = vec3(0.0);
    float weightSum = 0.0;
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            ivec2 texel = coordinate + ivec2(dx, dy);
            if (any(lessThan(texel, ivec2(0))) || any(greaterThanEqual(texel, FROXEL_EXTENT.xy))) { continue; }
            vec3 value = imageLoad(froxelLightImage, ivec3(texel, layer)).rgb;
            if (any(isnan(value)) || any(isinf(value))) { continue; }
            float weight = float((2 - abs(dx)) * (2 - abs(dy)));
            sum += max(value, vec3(0.0)) * weight;
            weightSum += weight;
        }
    }
    return weightSum > 0.0 ? sum / weightSum : vec3(0.0);
}

void main() {
    ivec2 coordinate = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(coordinate, FROXEL_EXTENT.xy))) { return; }
    int writeOffset = froxelWriteOffset();
    vec3 inscatter = vec3(0.0);
    float transmittance = 1.0;
#if defined(VPT_BEDROCK_ORIGINAL) && VPT_BEDROCK_ORIGINAL != 0 && VPT_BEDROCK_FOG != 0
    vec3 rgbTransmittance = vec3(1.0);
    vec3 rayDir = froxelRayDirection((vec2(coordinate) + 0.5) / vec2(FROXEL_EXTENT.xy));
#endif
    float previousDistance = 0.0;
    for (int slice = 0; slice < FROXEL_EXTENT.z; ++slice) {
        vec4 cell = imageLoad(froxelLightImage, ivec3(coordinate, slice + writeOffset));
#if defined(VPT_BEDROCK_ORIGINAL) && VPT_BEDROCK_ORIGINAL != 0 && VPT_BEDROCK_FOG != 0
        // Observed: distance at the centre, not the far boundary of the cell.
        float distance = froxelDistanceFromW((float(slice) + 0.5) / float(FROXEL_EXTENT.z));
#else
        float distance = froxelDistanceFromW(float(slice + 1) / float(FROXEL_EXTENT.z));
#endif
        float stepLength = max(distance - previousDistance, 0.0);
        float extinction = max(isnan(cell.a) || isinf(cell.a) ? 0.0 : cell.a, 1e-6);
        vec3 source = filteredFroxelLight(coordinate, slice + writeOffset);
#if defined(VPT_BEDROCK_ORIGINAL) && VPT_BEDROCK_ORIGINAL != 0 && VPT_BEDROCK_FOG != 0
        float worldY = froxelCameraOrigin().y + rayDir.y * distance + float(worldUBO.cameraPos.y);
        vec3 sigmaT = froxelBedrockExtinctionRGB(worldY);
        // Source already contains scattering from shadeBedrockFogCell. Match the discrete accumulation order.
        inscatter += rgbTransmittance * source * stepLength;
        vec3 encoded = sqrt(clamp(inscatter, vec3(0.0), vec3(65504.0)));
        imageStore(froxelIntegralImage, ivec3(coordinate, slice), vec4(encoded, 1.0));
        imageStore(froxelTransmissionImage, ivec3(coordinate, slice), vec4(rgbTransmittance, 1.0));
        rgbTransmittance *= exp(-sigmaT * stepLength);
#else
        float stepTransmittance = exp(-extinction * stepLength);
        inscatter += transmittance * source * (1.0 - stepTransmittance) / extinction;
        transmittance *= stepTransmittance;
        imageStore(froxelIntegralImage, ivec3(coordinate, slice),
                   vec4(clamp(inscatter, vec3(0.0), vec3(65504.0)), transmittance));
        imageStore(froxelTransmissionImage, ivec3(coordinate, slice), vec4(vec3(transmittance), 1.0));
#endif
        previousDistance = distance;
    }
}
