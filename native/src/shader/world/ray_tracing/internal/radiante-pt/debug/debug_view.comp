#version 460
#extension GL_GOOGLE_include_directive : require

// Fills radiante_debug_view with the chosen debug view (common/debug_view.glsl), from the guide images the ray
// generation shader wrote this frame, as display colours. Runs after the world pass, only while a view is chosen. The
// surface flags are written by the closest-hit shader itself (pt/pt_shade_default.glsl), so here they only get the
// sky, which no hit shader sees.

#include "common/shared.hpp"
#include "common/debug_view.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 3, binding = 1, rgba8) uniform readonly image2D diffuseAlbedoImage;
layout(set = 3, binding = 3, rgba16f) uniform readonly image2D normalRoughnessImage;
layout(set = 3, binding = 4, rg16f) uniform readonly image2D motionVectorImage;
layout(set = 3, binding = 5, r16f) uniform readonly image2D linearDepthImage;
layout(set = 3, binding = 12, rgba16f) uniform readonly image2D firstHitBaseEmissionImage;
layout(set = 5, binding = RADIANTE_DEBUG_VIEW_STORAGE_BINDING, rgba16f) uniform image2D radianteDebugViewImage;

#ifndef RADIANTE_DEBUG_VIEW
#    define RADIANTE_DEBUG_VIEW 0
#endif

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(texel, imageSize(radianteDebugViewImage)))) { return; }
    if (any(greaterThanEqual(texel, imageSize(linearDepthImage)))) { return; }

    float depth = imageLoad(linearDepthImage, texel).r;
    bool sky = depth >= INF_DISTANCE * 0.5;
    vec3 color = vec3(0.0);
#if RADIANTE_DEBUG_VIEW == RADIANTE_DEBUG_VIEW_ALBEDO
    // The denoiser's albedo guide: the sky's is its colour, scaled to its brightest channel.
    color = radianteDebugDisplay(imageLoad(diffuseAlbedoImage, texel).rgb);
#elif RADIANTE_DEBUG_VIEW == RADIANTE_DEBUG_VIEW_NORMAL
    vec3 normal = imageLoad(normalRoughnessImage, texel).xyz;
    color = sky || dot(normal, normal) < 1e-6 ? vec3(0.0) : normalize(normal) * 0.5 + 0.5;
#elif RADIANTE_DEBUG_VIEW == RADIANTE_DEBUG_VIEW_ROUGHNESS
    color = sky ? vec3(0.0) : vec3(clamp(imageLoad(normalRoughnessImage, texel).w, 0.0, 1.0));
#elif RADIANTE_DEBUG_VIEW == RADIANTE_DEBUG_VIEW_METALLIC
    color = sky ? vec3(0.0) : vec3(clamp(imageLoad(diffuseAlbedoImage, texel).a, 0.0, 1.0));
#elif RADIANTE_DEBUG_VIEW == RADIANTE_DEBUG_VIEW_EMISSION
    // HDR: squeezed into the screen's range, so a torch and lava both read.
    vec3 emission = max(imageLoad(firstHitBaseEmissionImage, texel).rgb, vec3(0.0));
    color = radianteDebugDisplay(emission / (1.0 + emission));
#elif RADIANTE_DEBUG_VIEW == RADIANTE_DEBUG_VIEW_DEPTH
    // View depth on a log scale: white at the camera, black at 1024 blocks and in the sky.
    color = sky ? vec3(0.0) : vec3(1.0 - clamp(log2(1.0 + max(depth, 0.0)) / 10.0, 0.0, 1.0));
#elif RADIANTE_DEBUG_VIEW == RADIANTE_DEBUG_VIEW_MOTION
    // Pixels moved since the last frame: red right, green down, grey still; 32 pixels reach full colour.
    vec2 motion = imageLoad(motionVectorImage, texel).xy;
    color = vec3(clamp(0.5 + motion / 64.0, 0.0, 1.0), 0.5);
#elif RADIANTE_DEBUG_VIEW == RADIANTE_DEBUG_VIEW_FLAGS
    if (!sky) { return; }
    color = vec3(0.0);
#endif
    imageStore(radianteDebugViewImage, texel, vec4(color, 1.0));
}
