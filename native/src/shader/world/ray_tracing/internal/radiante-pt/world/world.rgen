#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_control_flow_attributes : require

// 0: baseline; 1: optimized; 2: envelope; 3: baseline hand hits green inside the bounds, red outside.
#ifndef VPT_HAND_PRIMARY_BOUNDS
#    define VPT_HAND_PRIMARY_BOUNDS 1
#endif

#ifndef USE_SHARC
#    define USE_SHARC 0
#endif

// Shader Execution Reordering (NVIDIA RTX 40 and newer): each path ray is traced into a hit object, the GPU regroups
// the threads by what they hit, and only then runs the hit shaders, so neighbours in a warp shade the same material.
// VPT_SER is the player's toggle; VPT_SER_SUPPORTED is set by the renderer when the device has the feature.
#ifndef VPT_SER
#    define VPT_SER 0
#endif
#ifndef VPT_SER_SUPPORTED
#    define VPT_SER_SUPPORTED 0
#endif
#if VPT_SER != 0 && VPT_SER_SUPPORTED != 0
#    extension GL_NV_shader_invocation_reorder : require
#    define VPT_TRACE_PATH(flags, mask, sbtOffset, sbtStride, missIndex, origin, tMin, dir, tMax) traceRayEXT(topLevelAS, flags, mask, sbtOffset, sbtStride, missIndex, origin, tMin, dir, tMax, 0)
// Bounce rays, where the paths have scattered in every direction, are regrouped by what they hit before shading.
#    define VPT_TRACE_PATH_REORDERED(flags, mask, sbtOffset, sbtStride, missIndex, origin, tMin, dir, tMax) { hitObjectNV vptHitObject; hitObjectTraceRayNV(vptHitObject, topLevelAS, flags, mask, sbtOffset, sbtStride, missIndex, origin, tMin, dir, tMax, 0); reorderThreadNV(vptHitObject); hitObjectExecuteShaderNV(vptHitObject, 0); }
#else
#    define VPT_TRACE_PATH_REORDERED(flags, mask, sbtOffset, sbtStride, missIndex, origin, tMin, dir, tMax) traceRayEXT(topLevelAS, flags, mask, sbtOffset, sbtStride, missIndex, origin, tMin, dir, tMax, 0)
#    define VPT_TRACE_PATH(flags, mask, sbtOffset, sbtStride, missIndex, origin, tMin, dir, tMax) traceRayEXT(topLevelAS, flags, mask, sbtOffset, sbtStride, missIndex, origin, tMin, dir, tMax, 0)
#endif

#if USE_SHARC
#    extension GL_EXT_shader_atomic_int64 : require
#    extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#    extension GL_EXT_shader_16bit_storage : enable
#endif

