// The medium the camera is in, when it is one fogged as a medium of its own (lava, powder snow; water has its own
// branches): how thick it is and the light it shows, as homogeneousMediumSegment takes them, and the light the
// exposure meters in it, which the surfaces hidden behind it say nothing of, with how far the eye is held below that
// reading. False in air and in water.
bool cameraMedium(vec3 eyePos, out vec3 sigmaT, out vec3 sourceRadiance, out vec3 meterLight, out float exposureScale) {
    // As thick as vanilla's fog end says (MEDIUM_FOG_END_TRANSMITTANCE), so Fire Resistance and spectator mode see as
    // far as they do in vanilla.
    float extinction = -log(MEDIUM_FOG_END_TRANSMITTANCE) / max(float(worldUBO.fogEnd), 0.01);
    if (skyUBO.cameraSubmersionType == 0) {
        // Lava glows: the eye meters that glow, held at vanilla's dark red.
        sigmaT = vec3(extinction);
        sourceRadiance = LAVA_GLOW;
        meterLight = LAVA_GLOW;
        exposureScale = LAVA_EXPOSURE_SCALE;
        return true;
    }
    if (skyUBO.cameraSubmersionType == 2) {
        // Powder snow shows the light that reaches it, metered as the light on a white surface would be: bright
        // under an open sky, dim under a roof.
        // Asked from the top of the block the eye is in: from the eye itself the query met that block's own top face
        // and read every powder snow as roofed, under an open sky too.
        float toBlockTop = 1.0 - fract(float(worldUBO.cameraPos.y) + eyePos.y);
        float skyVisibility = volumetricSkyVisibility(eyePos + vec3(0.0, toBlockTop, 0.0), false);
        float skyLight = max(dot(texture(skyFull, vec3(0.0, 1.0, 0.0)).rgb, vec3(0.2126, 0.7152, 0.0722)) *
                             mix(POWDER_SNOW_SHADE, 1.0, skyVisibility), POWDER_SNOW_MIN_LIGHT);
        sigmaT = vec3(extinction);
        sourceRadiance = POWDER_SNOW_COLOR * skyLight;
        meterLight = vec3(skyLight);
        exposureScale = mix(POWDER_SNOW_SHADE_EXPOSURE, 1.0, skyVisibility);
        return true;
    }
    sigmaT = vec3(0.0);
    sourceRadiance = vec3(0.0);
    meterLight = vec3(0.0);
    exposureScale = 1.0;
    return false;
}

#if VPT_NRD_SIGNALS
// The hit distance NRD gets for a bounce that left for the sky: far, as NRD wants a miss.
const float NRD_MISS_HIT_DISTANCE = 1000.0;

// What the closest hit of the surface the camera sees recorded for NRD (pt_shade_default.glsl): the glow it was seen
// with, in one of this shader's own output images, which is written over with its real contents at the end.
void clearNrdRecord(ivec2 pixel) {
    imageStore(firstHitBaseEmissionImage, pixel, vec4(0.0));
}

vec3 readNrdRecord(ivec2 pixel) {
    memoryBarrierImage();
    return max(imageLoad(firstHitBaseEmissionImage, pixel).rgb, vec3(0.0));
}
#endif

void main() {
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
#if VPT_RESTIR != 0
    // This frame's reservoir starts empty: pixels that see the sky, water or glass first write none of their own,
    // and must not hand an old one on to the next frame.
    imageStore(vptRestirImage, ivec3(pixel, int((worldUBO.frameCounter & 1u) * 2u + 1u)), vec4(0.0, 0.0, -1.0, 0.0));
#endif
#if VPT_RESTIR_GI != 0 && !(SHARC_UPDATE && USE_SHARC)
    // The same for the first bounce's reservoir (pt/pt_restir_gi.glsl).
    restirGiClear(pixel);
#endif
#if VPT_FROXEL_ACTIVE && !(SHARC_UPDATE && USE_SHARC)
    shadeFroxels();
    // No fog for this pixel unless it gets that far (several paths return early); see writeFogMarchRecord.
    clearFogMarchRecord(pixel);
#endif
    vec2 resolution = vec2(gl_LaunchSizeEXT.xy);
#if SHARC_UPDATE && USE_SHARC
    vec2 fullResolution = vec2(imageSize(outputImage));
    ivec2 block = ivec2(gl_LaunchIDEXT.xy);
    uint downsampleFactor = max(sharcConfig.updateDownsampleFactor, 1u);
    uint blockHash = xxhash32(uvec3(uint(block.x), uint(block.y), sharcConfig.frameIndex ^ worldUBO.seed));
    ivec2 selectedOffset =
        ivec2(int(blockHash % downsampleFactor), int((blockHash / downsampleFactor) % downsampleFactor));
    pixel = block * int(downsampleFactor) + selectedOffset;
    resolution = fullResolution;
    if (pixel.x >= int(resolution.x) || pixel.y >= int(resolution.y)) { return; }
#endif
    vec2 pixelCenter = vec2(pixel) + 0.5;
    pixelCenter += worldUBO.cameraJitter;

    float fovY = fovYFromProj(worldUBO.cameraProjMat);
    float fovX = fovXFromProj(worldUBO.cameraProjMat);

    vec2 ndc = pixelCenter / resolution * 2.0 - 1.0;

    vec4 nearPoint = vec4(ndc, 0.0, 1.0);

    vec4 viewNear = worldUBO.cameraProjMatInv * nearPoint;
    viewNear /= viewNear.w;

    vec3 origin = vec3(worldUBO.cameraEffectedViewMatInv * vec4(0, 0, 0, 1));
    const vec3 eyePos = origin;
    vec3 direction = normalize(vec3(worldUBO.cameraEffectedViewMatInv * vec4(viewNear.xyz, 0.0)));
    const vec3 orgDirection = direction;

    const uint rayFlags = VPT_RAY_FLAGS;

#if USE_SHARC && SHARC_UPDATE
    traceSharcUpdate(pixel, resolution, origin, direction, fovY, fovX, rayFlags);
    return;
#else
    // The rest of main(), one part a file, in the order they run. Each is included here, inside the function, and
    // shares its local variables with the others: a variable one part declares is the next one's to read.
    // The camera's rays and the surface seen.
#include "world/main/main_primary.glsl"
    // The sky, or the surface's light and its bounces.
#include "world/main/main_paths.glsl"
    // Fog and the medium the camera is in.
#include "world/main/main_fog.glsl"
    // The images the denoiser and the upscaler read.
#include "world/main/main_guides.glsl"
    // The light meter for the exposure.
#include "world/main/main_light_meter.glsl"
    // Night vision, the fog record, debug views, the glow outline and the picture.
#include "world/main/main_compose.glsl"
#endif
}
