#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "util/alpha_mode.glsl"
#include "util/random.glsl"
#include "util/ray_cone.glsl"
#include "util/ray.glsl"
#include "util/util.glsl"
#include "common/shared.hpp"

layout(set = 0, binding = 0) uniform sampler2D textures[];

layout(set = 1, binding = 1) readonly buffer BLASOffsets {
    uint offsets[];
}
blasOffsets;

layout(set = 1, binding = 2) readonly buffer IndexBufferAddr {
    uint64_t addrs[];
}
indexBufferAddrs;

layout(set = 1, binding = 7) readonly buffer TextureMappingBuffer {
    TextureMapping mapping;
};

layout(set = 2, binding = 0) uniform Uniform {
    WorldUBO ubo;
};

layout(std430, buffer_reference, buffer_reference_align = 8) readonly buffer IndexBuffer {
    uint indices[];
}
indexBuffer;

#include "util/vertex.glsl"
#include "common/lod_coverage.glsl"
#include "common/seamless_glass.glsl"


layout(location = 0) rayPayloadInEXT MainRay mainRay;
hitAttributeEXT vec2 attribs;

void main() {
    if (VPT_LOD_COVERED(ubo)) {
        ignoreIntersectionEXT;
        return;
    }
    uint instanceID = gl_InstanceCustomIndexEXT;
    uint geometryID = gl_GeometryIndexEXT;
    uint geometryBufferIndex = getGeometryBufferIndex(instanceID, geometryID);

    uint i0, i1, i2;
    MaterialVertex m0, m1, m2;
    loadTriangleIndices(geometryBufferIndex, gl_PrimitiveID, i0, i1, i2);
    loadTriangleMaterial(geometryBufferIndex, i0, i1, i2, m0, m1, m2);

    vec3 baryCoords = vec3(1.0 - (attribs.x + attribs.y), attribs.x, attribs.y);
    uint packedData = m0.packedData;
    uint textureID = m0.textureID;
    uint alphaMode = getAlphaMode(packedData);

    float alpha = hasColorLayer(packedData) ?
                      (baryCoords.x * m0.colorLayer + baryCoords.y * m1.colorLayer + baryCoords.z * m2.colorLayer).a :
                      1.0;
    vec2 uv = vec2(0.0);
    float lod = 0.0;
    if (hasTexture(packedData)) {
        uv = baryCoords.x * m0.textureUV + baryCoords.y * m1.textureUV + baryCoords.z * m2.textureUV;
        PositionVertex p0, p1, p2;
        loadTrianglePositions(geometryBufferIndex, i0, i1, i2, p0, p1, p2);
        // Seamless glass works from the block grid; a held block is not on it.
        if (isGlassSurface(packedData) && !isHeldSurface(packedData)) {
            if (seamlessGlassHidesFace(p0.pos, p1.pos, p2.pos, packedData)) {
                ignoreIntersectionEXT;
                return;
            }
        }
#if defined(VPT_BEDROCK_ORIGINAL) && VPT_BEDROCK_ORIGINAL != 0
        // The experimental Bedrock profile (see default.rchit): what the camera sees goes into glass, ice, slime or
        // honey only by a face turned towards it and out only by one turned away; the faces in between (the inner
        // cube of a slime or honey block, the far shell once out) are left out of its way, as Bedrock leaves them
        // out of its view's traversal. Met one by one by the hit shader, they used up the camera's steps: through a
        // wall of honey or slime the view ran out of them and ended dark.
        if ((isGlassSurface(packedData) || isBlendSurface(packedData)) && !isHeldSurface(packedData) &&
            (rayBounce(mainRay) == 0u || rayCameraPath(mainRay) || mainRay.pad0 == RAY_VIEW_BOUNCE_MARK)) {
            bool towards = dot(cross(p1.pos - p0.pos, p2.pos - p0.pos), gl_ObjectRayDirectionEXT) < 0.0;
            if (rayInGlass(mainRay) == towards) {
                ignoreIntersectionEXT;
                return;
            }
        }
#endif

        float coneRadiusWorld = mainRay.coneWidth + gl_HitTEXT * mainRay.coneSpread;
        vec3 dposdu, dposdv;
        computedposduDv(p0.pos, p1.pos, p2.pos, m0.textureUV, m1.textureUV, m2.textureUV, dposdu, dposdv);
        if (isGlassSurface(packedData) && !isHeldSurface(packedData)) {
            vec3 objectPos = baryCoords.x * p0.pos + baryCoords.y * p1.pos + baryCoords.z * p2.pos;
            uv = seamlessGlassUV(uv, objectPos, dposdu, dposdv, packedData);
        }
        lod = lodWithCone(textures[nonuniformEXT(textureID)], uv, coneRadiusWorld, dposdu, dposdv);

        // Glass at its full-resolution alpha: mip levels blend a pane's frame into its clear middle.
        vec4 texel = sampleTexture(textures[nonuniformEXT(textureID)], uv, isGlassSurface(packedData) ? 0.0 : lod, false);
        alpha *= texel.a;
        if (alphaMode == ALPHA_MODE_ADDITIVE) {
            alpha = max(texel.r, max(texel.g, texel.b)) >= 0.1 ? alpha : 0.0;
        }
        if (alphaMode == ALPHA_MODE_DECAL) {
            alpha *= clamp(1.0 - 2.0 * dot(texel.rgb, vec3(0.2126, 0.7152, 0.0722)), 0.0, 1.0);
        }
    }

    // Glass is always kept as a hit, clear parts included (shaded as fully see-through glass, alpha 0): the hit shader
    // sees through it and tints the view by the glass's colour. Skipped at random by its alpha instead, as other
    // see-through surfaces are, most rays missed tinted or stained glass and it looked nearly clear.
    if (isGlassSurface(packedData)) {
        return;
    }

    if ((alphaMode == ALPHA_MODE_STOCHASTIC || alphaMode == ALPHA_MODE_DECAL) && alpha >= 0.05 && alpha < 0.999) {
        uint seed = xxhash32(uvec3(gl_LaunchIDEXT.xy, ubo.seed ^ uint(gl_PrimitiveID)));
        if (rand(seed) >= alpha) {
            ignoreIntersectionEXT;
            return;
        }
    }
    alpha = resolveSurfaceAlpha(alpha, alphaMode);
    if (alpha < 0.05) {
        ignoreIntersectionEXT;
        return;
    }

    // Past a boat's water patch (world/water_mask.rchit) the water inside the boat is not there, as in vanilla.
    // Water from chunks is marked in its vertices, not in a flag texture, so this has to come first.
    if (rayInsideBoat(mainRay) && isWaterSurface(packedData)) {
        ignoreIntersectionEXT;
        return;
    }

    if (!hasTexture(packedData)) { return; }

    int flagTextureID = mapping.entries[textureID].flag;
    if (flagTextureID < 0) { return; }

    ivec4 flags = ivec4(round(sampleTexture(textures[nonuniformEXT(flagTextureID)], uv, ceil(lod), false) * 255.0));
    if ((flags.r & 0x1) > 0 && rayIgnoreWaterSelf(mainRay)) {
        ignoreIntersectionEXT;
        return;
    }
    if (rayInsideBoat(mainRay) && (flags.r & 0x1) > 0) { ignoreIntersectionEXT; }
}
