#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_control_flow_attributes : require

#ifndef USE_SHARC
#    define USE_SHARC 0
#endif

// Shader Execution Reordering (NVIDIA RTX 40 and newer): each path ray is traced into a hit object, the GPU regroups
// the threads by what they hit, and only then runs the hit shaders, so neighbours in a warp shade the same material.
// VPT_SER is the player's toggle; VPT_SER_SUPPORTED is set by the renderer when the device has the feature.
#ifndef VPT_SER
#    define VPT_SER 0
#endif
#ifndef VPT_SER_SUPPORTED
#    define VPT_SER_SUPPORTED 0
#endif
#if VPT_SER != 0 && VPT_SER_SUPPORTED != 0
#    extension GL_NV_shader_invocation_reorder : require
#    define VPT_TRACE_PATH(flags, mask, sbtOffset, sbtStride, missIndex, origin, tMin, dir, tMax) traceRayEXT(topLevelAS, flags, mask, sbtOffset, sbtStride, missIndex, origin, tMin, dir, tMax, 0)
// Bounce rays, where the paths have scattered in every direction, are regrouped by what they hit before shading.
#    define VPT_TRACE_PATH_REORDERED(flags, mask, sbtOffset, sbtStride, missIndex, origin, tMin, dir, tMax) { hitObjectNV vptHitObject; hitObjectTraceRayNV(vptHitObject, topLevelAS, flags, mask, sbtOffset, sbtStride, missIndex, origin, tMin, dir, tMax, 0); reorderThreadNV(vptHitObject); hitObjectExecuteShaderNV(vptHitObject, 0); }
#else
#    define VPT_TRACE_PATH_REORDERED(flags, mask, sbtOffset, sbtStride, missIndex, origin, tMin, dir, tMax) traceRayEXT(topLevelAS, flags, mask, sbtOffset, sbtStride, missIndex, origin, tMin, dir, tMax, 0)
#    define VPT_TRACE_PATH(flags, mask, sbtOffset, sbtStride, missIndex, origin, tMin, dir, tMax) traceRayEXT(topLevelAS, flags, mask, sbtOffset, sbtStride, missIndex, origin, tMin, dir, tMax, 0)
#endif

#if USE_SHARC
#    extension GL_EXT_shader_atomic_int64 : require
#    extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#    extension GL_EXT_shader_16bit_storage : enable
#endif

#ifndef SHARC_UPDATE
#    define SHARC_UPDATE 0
#endif
#ifndef SHARC_QUERY
#    define SHARC_QUERY 0
#endif
#ifndef VPT_CLOUD_MODE
#    define VPT_CLOUD_MODE 1u
#endif
#ifndef VPT_CAPTURE_VOLUMETRIC_CLOUD_INDIRECT
#    define VPT_CAPTURE_VOLUMETRIC_CLOUD_INDIRECT 1
#endif
#ifndef VPT_VOLUMETRIC_LIGHT_MODE
#    define VPT_VOLUMETRIC_LIGHT_MODE 0
#endif
#ifndef VPT_VOLUMETRIC_LIGHT_MAX_STEPS
#    define VPT_VOLUMETRIC_LIGHT_MAX_STEPS 16
#endif
#ifndef VPT_VOLUMETRIC_LIGHT_SCATTERING_STRENGTH
#    define VPT_VOLUMETRIC_LIGHT_SCATTERING_STRENGTH 2.75
#endif
#ifndef VPT_BIOME_FOG_SCATTERING
#    define VPT_BIOME_FOG_SCATTERING 0.4
#endif
#ifndef VPT_BIOME_FOG_FORWARD
#    define VPT_BIOME_FOG_FORWARD 0.75
#endif
#ifndef VPT_VOLUMETRIC_LIGHT_MAX_DISTANCE
#    define VPT_VOLUMETRIC_LIGHT_MAX_DISTANCE 128.0
#endif
#ifndef VPT_VOLUMETRIC_LIGHT_LUMINANCE_LIMIT
#    define VPT_VOLUMETRIC_LIGHT_LUMINANCE_LIMIT 4.0
#endif
#ifndef VPT_CACHE_DEEP_BOUNCES
#    define VPT_CACHE_DEEP_BOUNCES 0
#endif
// The pack attribute always defines it; the fallback is for a build without it. It has to come before any include:
// common/block_light_data.glsl picks the scale of exact and point lights by whether it is defined when it is
// included (vptExactLightScale / vptPointLightScale), so a later fallback would leave the lights on another scale
// than the shading that multiplies by it.
#ifndef VPT_INDIRECT_LIGHT_STRENGTH
#    define VPT_INDIRECT_LIGHT_STRENGTH 16.0
#endif
#define VPT_VOLUMETRIC_LIGHT_MODE_VANILLA 0u
#define VPT_VOLUMETRIC_LIGHT_MODE_VOLUMETRIC 1u
// Froxel fog (common/froxel_fog.glsl) in place of the per-pixel march, with volumetric fog on.
#ifndef VPT_FROXEL_FOG
#    define VPT_FROXEL_FOG 0
#endif
#if VPT_FROXEL_FOG != 0 && VPT_VOLUMETRIC_LIGHT_MODE == 1
#    define VPT_FROXEL_ACTIVE 1
#else
#    define VPT_FROXEL_ACTIVE 0
#endif
#if USE_SHARC
#    define SHARC_ENABLE_GLSL 1
#    define SHARC_ENABLE_64_BIT_ATOMICS 1
#endif

#include "common/shared.hpp"
#include "util/disney.glsl"
#include "util/labpbr.glsl"
#include "util/random.glsl"
#include "util/ray_cone.glsl"
#include "util/ray.glsl"
#include "util/util.glsl"
#include "common/constants.glsl"
#if USE_SHARC
// clang-format off
#    include "extern/sharc/include/SharcGlsl.h"
#    include "extern/sharc/include/SharcCommon.h"
// clang-format on
#endif

// The raygen library (pt/): each file is a verbatim block of what used to be here, in the original order.
#include "pt/pt_bindings.glsl"

#include "pt/pt_fog.glsl"
#include "pt/pt_volumetric.glsl"
#include "pt/pt_froxel.glsl"
#include "pt/pt_sharc.glsl"
#include "pt/pt_primary.glsl"
#include "pt/pt_bounce.glsl"
#include "pt/pt_sharc_update.glsl"
#include "pt/pt_outputs.glsl"

#if VPT_NRD_SIGNALS
// The hit distance NRD gets for a bounce that left for the sky: far, as NRD wants a miss.
const float NRD_MISS_HIT_DISTANCE = 1000.0;

// What the closest hit of the surface the camera sees recorded for NRD (pt_shade_default.glsl): the glow it was seen
// with, in one of this shader's own output images, which is written over with its real contents at the end.
void clearNrdRecord(ivec2 pixel) {
    imageStore(firstHitBaseEmissionImage, pixel, vec4(0.0));
}

vec3 readNrdRecord(ivec2 pixel) {
    memoryBarrierImage();
    return max(imageLoad(firstHitBaseEmissionImage, pixel).rgb, vec3(0.0));
}
#endif

void main() {
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
#if VPT_RESTIR != 0
    // This frame's reservoir starts empty: pixels that see the sky, water or glass first write none of their own,
    // and must not hand an old one on to the next frame.
    imageStore(vptRestirImage, ivec3(pixel, int((worldUBO.frameCounter & 1u) * 2u + 1u)), vec4(0.0, 0.0, -1.0, 0.0));
#endif
#if VPT_FROXEL_ACTIVE && !(SHARC_UPDATE && USE_SHARC)
    shadeFroxels();
#endif
    vec2 resolution = vec2(gl_LaunchSizeEXT.xy);
#if SHARC_UPDATE && USE_SHARC
    vec2 fullResolution = vec2(imageSize(outputImage));
    ivec2 block = ivec2(gl_LaunchIDEXT.xy);
    uint downsampleFactor = max(sharcConfig.updateDownsampleFactor, 1u);
    uint blockHash = xxhash32(uvec3(uint(block.x), uint(block.y), sharcConfig.frameIndex ^ worldUBO.seed));
    ivec2 selectedOffset =
        ivec2(int(blockHash % downsampleFactor), int((blockHash / downsampleFactor) % downsampleFactor));
    pixel = block * int(downsampleFactor) + selectedOffset;
    resolution = fullResolution;
    if (pixel.x >= int(resolution.x) || pixel.y >= int(resolution.y)) { return; }
#endif
    vec2 pixelCenter = vec2(pixel) + 0.5;
    pixelCenter += worldUBO.cameraJitter;

    float fovY = fovYFromProj(worldUBO.cameraProjMat);
    float fovX = fovXFromProj(worldUBO.cameraProjMat);

    vec2 ndc = pixelCenter / resolution * 2.0 - 1.0;

    vec4 nearPoint = vec4(ndc, 0.0, 1.0);

    vec4 viewNear = worldUBO.cameraProjMatInv * nearPoint;
    viewNear /= viewNear.w;

    vec3 origin = vec3(worldUBO.cameraEffectedViewMatInv * vec4(0, 0, 0, 1));
    const vec3 eyePos = origin;
    vec3 direction = normalize(vec3(worldUBO.cameraEffectedViewMatInv * vec4(viewNear.xyz, 0.0)));
    const vec3 orgDirection = direction;

    const uint rayFlags = VPT_RAY_FLAGS;

#if USE_SHARC && SHARC_UPDATE
    traceSharcUpdate(pixel, resolution, origin, direction, fovY, fovX, rayFlags);
    return;
#else
    float surfaceDepth = INF_DISTANCE;
    bool psrHitSky = false;
    vec3 psrHitPosition;

    MaterialInfo firstHitMat;
    bool hasSecondHit = false;
    float distFirstToSecond = 0.0;
    bool isFirstHitNoisy = false;
    bool firstHitWaterSurface = false;
    bool isFirstHitDiffuse = false;
    bool isFirstHitRefraction = false;
    bool isFirstHitTransparent = false;
    vec3 firstHitEmission = vec3(0.0);
    vec3 firstHitDirectRadiance = vec3(0.0);
    vec3 firstHitIndirectRadiance = vec3(0.0);
    vec3 firstHitIncomingDirection = vec3(0.0);
    vec3 firstHitOutgoingDirection = vec3(0.0);
    vec3 firstHitNormal = vec3(0.0);
    vec3 firstHitWorldPos = vec3(0.0);
    vec3 transparentReflectionRadiance = vec3(0.0);
    vec3 transparentRefractionRadiance = vec3(0.0);
    bool hasTransparentReflection = false;
    bool hasTransparentRefraction = false;
    bool hasTransparentReflectionSecondHit = false;
    float transparentReflectionSecondHitDistance = 0.0;
    bool useTransparentSplit = false;
    vec3 composeFogAdditive = vec3(0.0);
    float composeFogTransmittance = -1.0;
    vec3 composeFogTransmissionRGB = vec3(1.0);
    bool composeFogIsRgb = false;
#    if SHARC_QUERY && USE_SHARC
    SharcParameters sharcParameters = makeSharcParameters();
    int sharcDebugBounceCount = 0;
    bool sharcDebugCacheHit = false;
#    endif

    MainRay worldRay;
    initMainRay(origin, direction, worldUBO.seed, coneSpreadFromFov(fovY, fovX, resolution), worldRay);
    FirstHitPayload worldFirstHit;
    g_glassReflection = false;
#if VPT_NRD_SIGNALS
    clearNrdRecord(pixel);
#endif
    tracePrimary(eyePos, orgDirection, rayFlags, 0, worldRay, worldFirstHit);
#if VPT_NRD_SIGNALS
    vec3 worldNrdEmission = readNrdRecord(pixel);
    clearNrdRecord(pixel);
#endif
    bool worldGlassReflection = g_glassReflection;
    vec3 worldPassThroughTint = g_passThroughTint;
    vec3 worldPassThroughRadiance = g_passThroughRadiance;
    float worldPassThroughDistance = g_passThroughDistance;


    // Minecraft draws the hand with a fixed field of view of its own, so it keeps its size when the FOV setting
    // changes (GameRenderer.render3dHud builds its projection from cameraState.hudFov). The rays that look for the
    // hand carry the same frustum; everything else keeps the world's.
    vec3 handDirection = orgDirection;
    if (worldUBO.handFovScale > 0.0 && abs(worldUBO.handFovScale - 1.0) > 1e-4) {
        handDirection = normalize(vec3(worldUBO.cameraEffectedViewMatInv *
                                       vec4(viewNear.xy * worldUBO.handFovScale, viewNear.z, 0.0)));
    }

    MainRay handRay;
    initMainRay(origin, handDirection, worldUBO.seed ^ 0x9E3779B9u, coneSpreadFromFov(fovY, fovX, resolution),
                handRay);
    FirstHitPayload handFirstHit;
    // Only while the hands are drawn (bit 1 of isFirstPerson): with none to find, this second camera ray per pixel cost
    // a quarter of a millisecond at 1280x720 for nothing (spectator, F1, third person).
    if ((worldUBO.isFirstPerson & 2u) != 0u) {
        tracePrimary(eyePos, handDirection, rayFlags, 1, handRay, handFirstHit);
    } else {
        handFirstHit = worldFirstHit;
        handFirstHit.surfaceDepth = INF_DISTANCE;
    }
#if VPT_NRD_SIGNALS
    vec3 nrdEmission = handFirstHit.surfaceDepth != INF_DISTANCE ? readNrdRecord(pixel) : worldNrdEmission;
    // The direct light of the surface seen, all of it, before the bounces replace the ray's.
    vec3 nrdFirstHitDirect = vec3(0.0);
#endif
    vec3 handPassThroughTint = g_passThroughTint;
    vec3 handPassThroughRadiance = g_passThroughRadiance;
    float handPassThroughDistance = g_passThroughDistance;

    int isHand = 0;
    g_glassReflection = worldGlassReflection;
    FirstHitPayload selectedFirstHit = worldFirstHit;
    mainRay = worldRay;
    g_passThroughTint = worldPassThroughTint;
    g_passThroughRadiance = worldPassThroughRadiance;
    g_passThroughDistance = worldPassThroughDistance;
    if (handFirstHit.surfaceDepth != INF_DISTANCE) {
        isHand = 1;
        selectedFirstHit = handFirstHit;
        mainRay = handRay;
        g_passThroughTint = handPassThroughTint;
        g_passThroughRadiance = handPassThroughRadiance;
        g_passThroughDistance = handPassThroughDistance;
    }

    // The glass's reflection of the world, traced from where the camera's ray met it (see default.rchit). Added to
    // the picture and, as it is not part of the surface behind, to the channel the denoiser leaves as it is.
    vec3 glassReflectionRadiance = vec3(0.0);
    if (g_glassReflection && isHand == 0) {
        MainRay saved = mainRay;
        MainRay reflection = mainRay;
        resetMainRay(reflection, selectedFirstHit.startBounce);
        reflection.origin = g_glassReflectionOrigin + g_glassReflectionDirection * 0.002;
        reflection.direction = g_glassReflectionDirection;
        reflection.radiance = vec3(0.0);
        reflection.throughput = g_glassReflectionWeight;
#if defined(VPT_BEDROCK_ORIGINAL) && VPT_BEDROCK_ORIGINAL != 0
        raySetInWater(reflection, (g_glassReflectionMedium & 1u) != 0u);
        raySetInGlass(reflection, (g_glassReflectionMedium & 2u) != 0u);
        raySetGlassParentWater(reflection, (g_glassReflectionMedium & 4u) != 0u);
#endif
        reflection.seed = xxhash32(uvec3(saved.seed, 0x51ED27u, worldUBO.seed));
        raySetLobeType(reflection, 1u);
        raySetCameraPath(reflection, false);
        raySetIgnoreWaterSelf(reflection, false);
        bool reflectionHit;
        float reflectionDistance;
        traceSecondary(reflection, selectedFirstHit.startBounce, 0,
#    if SHARC_QUERY && USE_SHARC
                      sharcParameters, sharcDebugBounceCount, sharcDebugCacheHit,
#    endif
                      reflectionHit, reflectionDistance);
        glassReflectionRadiance = mainRay.radiance;
        if (any(isnan(glassReflectionRadiance)) || any(isinf(glassReflectionRadiance))) {
            glassReflectionRadiance = vec3(0.0);
        }
        mainRay = saved;
    }

    bool hitSky = selectedFirstHit.hitSky;
#if defined(VPT_BEDROCK_ORIGINAL) && VPT_BEDROCK_ORIGINAL != 0
    // Stars are drawn only where the view ends in the sky: they have no medium of their own to fade them.
    float postStarCloudTransmittance = hitSky ? clamp(mainRay.directLightRadiance.x, 0.0, 1.0) : 0.0;
#else
    float postStarCloudTransmittance = hitSky ? clamp(mainRay.directLightRadiance.x, 0.0, 1.0) : 1.0;
#endif
    float viewDepth = selectedFirstHit.viewDepth;
    int startBounce = selectedFirstHit.startBounce;
    firstHitIncomingDirection = selectedFirstHit.incomingDirection;
    firstHitOutgoingDirection = selectedFirstHit.outgoingDirection;
    firstHitNormal = selectedFirstHit.normal;
    firstHitWorldPos = selectedFirstHit.worldPos;
    surfaceDepth = selectedFirstHit.surfaceDepth;

    imageStore(firstHitDepthImage, pixel, vec4(selectedFirstHit.firstHitLinearDepth));

    dvec3 currCameraPos = worldUBO.cameraPos.xyz;
    dvec3 lastCameraPos = lastWorldUBO.cameraPos.xyz;
    vec3 cameraDelta = vec3(currCameraPos - lastCameraPos);
    mat4 prevRelativeMVP = lastWorldUBO.cameraProjMat * lastWorldUBO.cameraEffectedViewMat;

    if (hitSky) {
        mainRay.radiance += glassReflectionRadiance;
        imageStore(outputImage, pixel, vec4(storedRadiance(mainRay.radiance), 1.0));
        // The sky's albedo guide is its colour, and what the denoiser takes for the light on it is the picture
        // divided by that guide. Tone mapped, the guide made that light at least 1 however dark the sky was, and at
        // dusk, at night or in fog - where the light on a block is a fraction of that - it bled into the pixels
        // along every silhouette: a pale rim on the edges of blocks and of the hand. Dividing by the brightest
        // channel instead keeps the sky's light on the scale of what is next to it.
        float skyLevel = max(max(mainRay.radiance.r, max(mainRay.radiance.g, mainRay.radiance.b)), SKY_GUIDE_MIN_LEVEL);
        imageStore(diffuseAlbedoImage, pixel, vec4(clamp(mainRay.radiance / skyLevel, 0.0, 1.0), 0));
        imageStore(specularAlbedoImage, pixel, vec4(0));
        imageStore(normalRoughnessImage, pixel, vec4(0.0));

        imageStore(linearDepthImage, pixel, vec4(INF_DISTANCE));
        vec2 motionVec = computeCameraMotionVector(prevRelativeMVP, pixelCenter, vec4(orgDirection, 0.0));
        imageStore(motionVectorImage, pixel, vec4(motionVec, vec2(0.0)));

        psrHitSky = true;
    } else {
        psrHitSky = false;

        hasSecondHit = false;
        distFirstToSecond = 0.0;
        firstHitEmission = vec3(0.0);
        firstHitDirectRadiance = vec3(0.0);
        firstHitIndirectRadiance = vec3(0.0);
        transparentReflectionRadiance = vec3(0.0);
        transparentRefractionRadiance = vec3(0.0);
        hasTransparentReflection = false;
        hasTransparentRefraction = false;
        hasTransparentReflectionSecondHit = false;
        transparentReflectionSecondHitDistance = 0.0;
        useTransparentSplit = false;
#    if USE_SHARC && SHARC_QUERY
        sharcDebugBounceCount = 0;
        sharcDebugCacheHit = false;
#    endif

        firstHitMat = rayLoadMaterial(mainRay);
        firstHitWaterSurface = rayLoadAux(mainRay).y > 0.5;
        imageStore(diffuseAlbedoImage, pixel,
                   vec4(firstHitMat.albedoValue.rgb * firstHitMat.albedoValue.a, firstHitMat.metallic));
        vec3 specularGuide = firstHitMat.f0;
#if defined(VPT_BEDROCK_ORIGINAL) && VPT_BEDROCK_ORIGINAL != 0
        // The denoiser's specular guide as the reflectance in the view's direction, not at normal incidence.
        float guideNoV = abs(dot(-firstHitIncomingDirection, firstHitNormal));
        if (firstHitWaterSurface) {
            // The same interface weight as initTransparent, total internal reflection included. Aux holds the
            // medium the ray came in through, from before the hit shader swapped it.
            float guideEta = rayLoadAux(mainRay).y > 1.5 ? firstHitMat.ior : 1.0 / firstHitMat.ior;
            specularGuide = vec3(vptInterfaceFresnel(guideNoV, guideEta));
        } else if (firstHitMat.transmission <= 1e-6) {
            // Opaque glass borders and other shaded surfaces keep their own normals and roughness; the guide
            // follows their directional reflectance.
            specularGuide = reflectionAlbedoGuide(firstHitMat.f0, firstHitMat.roughness, guideNoV);
        }
#endif
        imageStore(specularAlbedoImage, pixel, vec4(specularGuide, 0.0));

        imageStore(normalRoughnessImage, pixel, vec4(mainRay.normal, firstHitMat.roughness));

        imageStore(linearDepthImage, pixel, vec4(viewDepth));

        {
            vec3 originRelativeToPrevCam = origin + orgDirection * selectedFirstHit.tracedDistance + cameraDelta;
            if (mainRay.hasPrevScenePos > 0u) { originRelativeToPrevCam = mainRay.prevScenePos; }
            // The held item and arm are fixed to the camera, not the world: they turn and move with it. Their world
            // position would send the upscaler's history looking for them where the world was, and they smeared
            // into ghosts whenever the camera turned. They are not fixed to the screen either, though: view bobbing
            // sways the view while they stay put, so a map in hand drifts across the screen with every step, and a
            // zero motion vector tore it apart while walking. Where the hand sat last frame is the same point in the
            // camera's own (unbobbed) frame; last frame's bobbed projection then says where that was on screen.
            // The held item also moves by itself: a map held in both hands rises and sinks as the view tilts, and
            // arms swing. Last frame's vertices of the hand say where it really was, but only roughly - a little
            // off from frame to frame even when the hand is still. Following them on every small difference, or
            // dropping the history on large ones, left whatever was held grainy: the upscaler kept starting over.
            // So the hand is taken as fixed to the camera unless it clearly moved against it.
            // The hand is traced with a field of view of its own (handFovScale): where a point of it shows on
            // screen is the world projection with x and y divided by that scale. Projecting it as world geometry
            // - and taking the point along the world ray rather than the hand ray - put its motion vectors off by
            // as much as the view moved, so everything held smeared and went grainy in motion.
            vec2 motionVec;
            if (isHand == 1) {
                vec3 handPos = origin + handDirection * selectedFirstHit.tracedDistance;
                vec3 handInView = mat3(worldUBO.cameraViewMat) * handPos;
                vec3 fixedInCamera = transpose(mat3(lastWorldUBO.cameraViewMat)) * handInView;
                motionVec = handMotionVector(prevRelativeMVP, pixelCenter, fixedInCamera);
                if (mainRay.hasPrevScenePos > 0u) {
                    vec2 realMotion = handMotionVector(prevRelativeMVP, pixelCenter, mainRay.prevScenePos);
                    // Moved against the camera by a few pixels or more (a swing, a map tilting with the pitch):
                    // follow it. A jump larger than any hand makes in a frame is a mismatch between last frame's
                    // vertices and this frame's (another item, another pose), not motion; the camera-fixed guess
                    // stands then.
                    float moved = length(realMotion - motionVec);
                    float screen = float(max(gl_LaunchSizeEXT.x, gl_LaunchSizeEXT.y));
                    if (moved > max(3.0, screen * 0.004) && moved < screen * 0.15) {
                        motionVec = realMotion;
                    }
                }
            } else {
                motionVec = computeCameraMotionVector(prevRelativeMVP, pixelCenter, vec4(originRelativeToPrevCam, 1.0));
            }
            imageStore(motionVectorImage, pixel, vec4(motionVec, 0.0, 0.0));
        }

        // (Bedrock RTX adds no light of its own: its constant ambient is zero, calibrated to Bedrock RTX.)
#if !defined(VPT_BEDROCK_ORIGINAL) || VPT_BEDROCK_ORIGINAL == 0
        if (startBounce == 1) {
            mainRay.radiance += VPT_BASIC_RADIANCE * firstHitMat.albedoValue.rgb * firstHitMat.albedoValue.a * mainRay.throughput;
        }
#endif

        psrHitPosition = firstHitWorldPos;

        isFirstHitNoisy = rayIsNoisy(mainRay);
        isFirstHitDiffuse = false;
        isFirstHitRefraction = false;
        isFirstHitTransparent = false;
        firstHitDirectRadiance = vec3(0.0);
        firstHitIndirectRadiance = vec3(0.0);
        if (isFirstHitNoisy) {
            // Same strength as the hit shaders give a glowing surface; see default.rchit.
#if VPT_BEDROCK_SPECULAR
            // Its colour a tenth of the way to grey, as Bedrock RTX shows a glow (block_light.glsl).
            vec3 glowColour = mix(firstHitMat.albedoValue.rgb,
                                  vec3(dot(firstHitMat.albedoValue.rgb, vec3(0.2126, 0.7152, 0.0722))), 0.1);
            firstHitEmission = glowColour * firstHitMat.emission * worldUBO.emissionBrightness *
                               VPT_BEDROCK_SEEN_EMISSION;
#else
            firstHitEmission = firstHitMat.albedoValue.rgb * firstHitMat.emission *
                               worldUBO.emissionBrightness * 16.0 * VPT_DIRECT_LIGHT_STRENGTH;
#endif
#if VPT_NRD_SIGNALS
            nrdFirstHitDirect = mainRay.directLightRadiance;
#endif
            if (rayLobeType(mainRay) == 0u) {
                isFirstHitDiffuse = true;
                firstHitDirectRadiance = mainRay.directLightRadiance;
            } else if (rayLobeType(mainRay) == 2u) {
                isFirstHitTransparent = true;
                float incomingSign = dot(firstHitIncomingDirection, firstHitNormal);
                float outgoingSign = dot(firstHitOutgoingDirection, firstHitNormal);
                isFirstHitRefraction = incomingSign * outgoingSign > 0.0;
            }
        }

        if (isFirstHitNoisy) {
            if (isFirstHitTransparent) {
                // Only for glass. A translucent solid (ice) is mostly shaded as a surface and only partly let
                // through; recomposing the frames that happened to go through as pure glass made it flicker.
                // Water too: its surface is traced as a reflection and a refraction each frame, so what lies under
                // shallow water stays sharp instead of the denoiser blending a random pick of the two. (Sheets of
                // water seen side on are passed straight through before this, see default.rchit.)
                useTransparentSplit = VPT_TRANSPARENT_SPLIT_MODE == VPT_TRANSPARENT_SPLIT_MODE_DETERMINISTIC &&
                                      firstHitMat.transmission > 0.95;

                if (useTransparentSplit) {
                    // Checkerboard (VPT_TRANSPARENT_CHECKERBOARD): one cell traces the reflection, the other the
                    // refraction, swapping every frame, each at twice its weight - one ray per pixel instead of two,
                    // as Bedrock RTX does for water and glass. The branch left out counts as traced and black.
                    bool traceReflection = true;
                    bool traceRefraction = true;
                    float branchWeight = 1.0;
                    if (VPT_TRANSPARENT_CHECKERBOARD != 0 && isHand == 0) {
                        traceReflection = checkerboardCell(pixel);
                        traceRefraction = !traceReflection;
                        branchWeight = 2.0;
                        hasTransparentReflection = !traceReflection;
                        hasTransparentRefraction = !traceRefraction;
                    }
                    // Both branches start from the ray as it left the first hit. Tracing the reflection leaves the
                    // end of its path in mainRay; started from that, the refraction no longer knew its surface was
                    // water (the mark is in the ray): it went straight on as through glass, tinted like glass, and
                    // not counted as in the water. Water seen from above had no depth to its colour, and where
                    // the view then left a thin body of water through its side - the top of a waterfall - that
                    // side counted as going into water, and all the world behind it turned deep-sea dark.
                    MainRay firstHitRay = mainRay;
                    MainRay transparentReflectionRay;
                    if (traceReflection &&
                        initTransparent(firstHitRay, firstHitMat, firstHitIncomingDirection, firstHitNormal,
                                        firstHitWorldPos, 0x9E3779B9u, true, transparentReflectionRay)) {
                        transparentReflectionRay.throughput *= branchWeight;
                        traceTransparent(transparentReflectionRay, startBounce, isHand,
#    if SHARC_QUERY && USE_SHARC
                                         sharcParameters, sharcDebugBounceCount, sharcDebugCacheHit,
#    endif
                                         hasTransparentReflectionSecondHit, transparentReflectionSecondHitDistance);
                        transparentReflectionRadiance = transparentReflectionRay.radiance;
                        hasTransparentReflection = true;
                    }
                    // The two branches replace the ray's own radiance; what the glass in front added goes with them.
                    transparentReflectionRadiance += g_passThroughRadiance;

                    MainRay transparentRefractionRay;
                    if (traceRefraction &&
                        initTransparent(firstHitRay, firstHitMat, firstHitIncomingDirection, firstHitNormal,
                                        firstHitWorldPos, 0x3C6EF372u, false, transparentRefractionRay)) {
                        transparentRefractionRay.throughput *= branchWeight;
                        bool hasTransparentRefractionSecondHit = false;
                        float transparentRefractionSecondHitDistance = 0.0;
                        traceTransparent(transparentRefractionRay, startBounce, isHand,
#    if SHARC_QUERY && USE_SHARC
                                         sharcParameters, sharcDebugBounceCount, sharcDebugCacheHit,
#    endif
                                         hasTransparentRefractionSecondHit, transparentRefractionSecondHitDistance);
                        transparentRefractionRadiance = transparentRefractionRay.radiance;
                        hasTransparentRefraction = true;
                    }

                    mainRay.radiance = transparentReflectionRadiance + transparentRefractionRadiance;
#if defined(VPT_BEDROCK_ORIGINAL) && VPT_BEDROCK_ORIGINAL != 0
                    // The water texture's own layer over the surface, lit where it was met (pt_shade_default.glsl).
                    if (firstHitWaterSurface) {
                        transparentRefractionRadiance += firstHitRay.directLightRadiance;
                        mainRay.radiance += firstHitRay.directLightRadiance;
                    }
#endif
                    mainRay.directLightRadiance = vec3(0.0);
                } else {
                    traceSecondary(mainRay, startBounce, isHand,
#    if SHARC_QUERY && USE_SHARC
                                  sharcParameters, sharcDebugBounceCount, sharcDebugCacheHit,
#    endif
                                  hasSecondHit, distFirstToSecond);
                }
            } else {
                traceSecondaryAveraged(isHand == 1 ? VPT_HAND_SAMPLES : 1, startBounce, isHand,
#    if SHARC_QUERY && USE_SHARC
                              sharcParameters, sharcDebugBounceCount, sharcDebugCacheHit,
#    endif
                              hasSecondHit, distFirstToSecond);

                if (isFirstHitDiffuse) { firstHitIndirectRadiance = mainRay.radiance - firstHitDirectRadiance; }
            }
        } else {
            traceSecondaryAveraged(isHand == 1 ? VPT_HAND_SAMPLES : 1, startBounce, isHand,
#    if SHARC_QUERY && USE_SHARC
                          sharcParameters, sharcDebugBounceCount, sharcDebugCacheHit,
#    endif
                          hasSecondHit, distFirstToSecond);
        }
    }

    if (!hitSky) { mainRay.radiance += glassReflectionRadiance; }
    if (isnan(mainRay.radiance.r) || isinf(mainRay.radiance.r)) { mainRay.radiance = vec3(0.0, 0.0, 0.0); }
    if (isnan(mainRay.radiance.g) || isinf(mainRay.radiance.g)) { mainRay.radiance = vec3(0.0, 0.0, 0.0); }
    if (isnan(mainRay.radiance.b) || isinf(mainRay.radiance.b)) { mainRay.radiance = vec3(0.0, 0.0, 0.0); }

    float densityAir = 0.0000;
    float densityFog = 2.0 / (worldUBO.fogEnd - worldUBO.fogStart);
    bool useVolumetricFog = VPT_VOLUMETRIC_LIGHT_MODE == VPT_VOLUMETRIC_LIGHT_MODE_VOLUMETRIC;
    float transparentFogTransmittance = 1.0;
    vec3 transparentFogAdditive = vec3(0.0);
    if (skyUBO.hasBlindnessOrDarkness > 0) {
        // Blindness and Darkness: vanilla's fog closes in to a few blocks (fogStart/fogEnd follow the effect's
        // pulse) and everything past it goes black. Applied even where fog is otherwise skipped.
        // Linear from fogStart to fogEnd as vanilla's fog is; the sky (and, while the effect is still strong, all of
        // it) goes black with the effect's strength, so it fades back in as the fog pulls away instead of popping.
        float strength = skyUBO.fogControls.x;
        // Darkness's pulse also pulls the fog in: at each beat the wall closes to about half its distance and
        // then eases back out, so the dark visibly breathes toward the player.
        float pulseReach = 1.0 - 0.5 * skyUBO.fogControls.y;
        float effectFogStart = worldUBO.fogStart * pulseReach;
        float effectFogEnd = worldUBO.fogEnd * pulseReach;
        float fogAmount = surfaceDepth == INF_DISTANCE ?
            1.0 : clamp((surfaceDepth - effectFogStart) / max(effectFogEnd - effectFogStart, 0.01), 0.0, 1.0);
        float transmittance = 1.0 - fogAmount * smoothstep(0.0, 0.3, strength);
        // Darkness's pulse: vanilla takes it off the lightmap, so everything lit dims at once and the world blinks.
        transmittance *= 1.0 - 0.95 * skyUBO.fogControls.y;
        // Black, not the fog colour: that one is still lifted by the sky and came out grey.
        vec3 additive = vec3(0.0);
        if (useTransparentSplit) {
            transparentReflectionRadiance *= transmittance;
            transparentRefractionRadiance *= transmittance;
            transparentFogAdditive = additive;
            transparentFogTransmittance = transmittance;
        } else {
            mainRay.radiance = mainRay.radiance * transmittance + additive;
            composeFogTransmittance = transmittance;
            composeFogAdditive = additive;
        }
    } else if (!raySkipFog(mainRay)) {
        if (skyUBO.cameraSubmersionType == 1 && waterMediumActive()) {
            // A Bedrock pack's water: the camera's stretch of it absorbs and scatters like every other one. Its
            // first stretch only: past the first surface the hit shaders fog the water, and fogging up to the
            // first solid surface here counted the water behind a pane or a particle twice. A ray that hits nothing
            // has water without a far side (it used to count as none, showing the bright open sky deep under water).
            float waterDistance = selectedFirstHit.cameraWaterDistance;
            vec3 waterTransmittance;
            vec3 waterScatter;
#if defined(VPT_BEDROCK_ORIGINAL) && VPT_BEDROCK_ORIGINAL != 0
            waterMediumSegmentBedrock(waterDistance >= INF_DISTANCE || VPT_MEDIUM_DISTANCE_CLAMP == 0 ?
                                          waterDistance : min(waterDistance, 50.0),
                                      VPT_WATER_DENSITY, vec3(0.0), orgDirection, waterTransmittance, waterScatter);
#else
            if (waterDistance >= INF_DISTANCE) {
                waterMediumSegmentUnclamped(waterDistance, VPT_WATER_DENSITY, waterTransmittance, waterScatter);
            } else {
                waterMediumSegment(waterDistance, VPT_WATER_DENSITY, waterTransmittance, waterScatter);
            }
#endif
            // Lit by the sky above: the camera's water under a roof or in a cave does not glow with it.
            waterScatter *= mix(0.35, 1.0, volumetricSkyVisibility(eyePos, false));
            waterScatter += waterGodRays(eyePos, orgDirection, waterDistance);
            float waterComposeTransmittance = clamp(volumetricLightLuminance(waterTransmittance), 0.0, 1.0);
            if (useTransparentSplit) {
                transparentReflectionRadiance *= waterTransmittance;
                transparentRefractionRadiance *= waterTransmittance;
                transparentFogAdditive = waterScatter;
                transparentFogTransmittance = waterComposeTransmittance;
            } else {
                mainRay.radiance = mainRay.radiance * waterTransmittance + waterScatter;
                composeFogTransmittance = waterComposeTransmittance;
                composeFogAdditive = waterScatter;
#if defined(VPT_BEDROCK_ORIGINAL) && VPT_BEDROCK_ORIGINAL != 0
                composeFogTransmissionRGB = waterTransmittance;
                composeFogIsRgb = true;
#endif
            }
        }
#if defined(VPT_BEDROCK_ORIGINAL) && VPT_BEDROCK_ORIGINAL != 0
        if (skyUBO.cameraSubmersionType == 1 && !waterMediumActive()) {
#else
        if (skyUBO.cameraSubmersionType == 1) {
#endif
            // How far one sees under water: past a few dozen blocks everything fades into the water's own colour
            // (a sea blue), lit as the water around the camera is. Without it a clear ocean
            // showed its floor and the shore far away, as if through air.
            // Each biome's water has its own reach and colour (skyUBO.waterFog, from BiomeAmbiance): clear and
            // bright by a beach, dark and close in the deep ocean, a murk in a swamp. One water for all of them
            // with the option off.
            bool biomeWater = skyUBO.waterFog.a > 0.5;
            float visibility = biomeWater ? skyUBO.waterFog.a : UNDERWATER_VISIBILITY;
            float seen = surfaceDepth == INF_DISTANCE || surfaceDepth <= 0.0 ? visibility * 4.0 : surfaceDepth;
            float clearness = exp(-seen / visibility);
            // a clear sea blue for plain water (vanilla's water fog is nearly navy)
            vec3 fogTint = biomeWater ? max(skyUBO.waterFog.rgb, vec3(0.0)) : UNDERWATER_FOG_TINT;
            // How much of the sky lights the water around the camera. With a biome's water it is the sky light over
            // the water's surface there (skyUBO.waterAlbedo.a, eased by BiomeAmbiance); one ray straight up from the
            // eye went black under a lily pad or a branch and lit again a step on, and a swamp was mostly black.
            float skyOverWater =
                biomeWater ? clamp(skyUBO.waterAlbedo.a, 0.0, 1.0) : volumetricSkyVisibility(eyePos, false);
            float ambient = dot(texture(skyFull, vec3(0.0, 1.0, 0.0)).rgb, vec3(0.2126, 0.7152, 0.0722)) *
                            mix(0.2, 1.0, skyOverWater);
            // The deeper the camera, the less of the sky's light is left in the water around it: the colour the
            // view fades into darkens on the way down, sooner in water one sees less far in.
            if (biomeWater) { ambient *= exp(-waterCameraDepth() * UNDERWATER_DEPTH_DIMMING / visibility); }
            vec3 fogLight = fogTint * ambient * UNDERWATER_FOG_LIGHT;
            if (useTransparentSplit) {
                transparentReflectionRadiance *= clearness;
                transparentRefractionRadiance *= clearness;
                transparentFogAdditive = transparentFogAdditive * clearness + fogLight * (1.0 - clearness);
                transparentFogTransmittance *= clearness;
            } else {
                mainRay.radiance = mainRay.radiance * clearness + fogLight * (1.0 - clearness);
                composeFogAdditive = composeFogAdditive * clearness + fogLight * (1.0 - clearness);
                composeFogTransmittance = (composeFogTransmittance < 0.0 ? 1.0 : composeFogTransmittance) * clearness;
            }
        }
        if (skyUBO.cameraSubmersionType == 1 && waterMediumActive()) {
        } else if (skyUBO.cameraSubmersionType == 1) {
            vec3 waterColor = vec3(0.0, 0.48, 0.65);
            vec3 preFogRadiance = mainRay.radiance * waterColor;

            if (useTransparentSplit) {
                applyFog(preFogRadiance, surfaceDepth, worldUBO.fogStart, densityAir, densityFog, waterColor * 0.01,
                         mainRay.radiance, transparentFogTransmittance, transparentFogAdditive);
                transparentReflectionRadiance *= waterColor * transparentFogTransmittance;
                transparentRefractionRadiance *= waterColor * transparentFogTransmittance;
            } else {
                applyFog(preFogRadiance, surfaceDepth, worldUBO.fogStart, densityAir, densityFog, waterColor * 0.01,
                         mainRay.radiance, composeFogTransmittance, composeFogAdditive);
            }
        } else {
            if (worldUBO.skyType == 0) {
                if (useTransparentSplit) {
                    applyFog(mainRay.radiance, surfaceDepth, worldUBO.fogStart, densityAir, densityFog,
                             worldUBO.fogColor.rgb * NETHER_FOG_SCALE, mainRay.radiance, transparentFogTransmittance,
                             transparentFogAdditive);
                    transparentReflectionRadiance *= transparentFogTransmittance;
                    transparentRefractionRadiance *= transparentFogTransmittance;
                } else {
                    applyFog(mainRay.radiance, surfaceDepth, worldUBO.fogStart, densityAir, densityFog,
                             worldUBO.fogColor.rgb * NETHER_FOG_SCALE, mainRay.radiance, composeFogTransmittance,
                             composeFogAdditive);
                }
            } else if (worldUBO.skyType == 1) {
                if (!useVolumetricFog && !psrHitSky) {
                    vec3 eyeToPSRHitPosition = psrHitPosition - eyePos;
                    eyeToPSRHitPosition.y = 0;
                    float len = length(eyeToPSRHitPosition);

                    vec3 sunDir = celestialSunDirection();
                    vec3 rayDir = orgDirection;
                    float progress = skyUBO.rainGradient;
                    vec3 rainyRadiance = mix(vec3(0.0), vec3(0.1), smoothstep(-0.3, 0.3, sunDir.y));
                    vec3 sunnyRadiance = texture(skyFull, rayDir).rgb;
                    vec3 fogRadiance = mix(sunnyRadiance, rainyRadiance, progress);

                    if (useTransparentSplit) {
                        applyFog(mainRay.radiance, len, worldUBO.fogStart, densityAir, densityFog, fogRadiance,
                                 mainRay.radiance, transparentFogTransmittance, transparentFogAdditive);
                        transparentReflectionRadiance *= transparentFogTransmittance;
                        transparentRefractionRadiance *= transparentFogTransmittance;
                    } else {
                        applyFog(mainRay.radiance, len, worldUBO.fogStart, densityAir, densityFog, fogRadiance,
                                 mainRay.radiance, composeFogTransmittance, composeFogAdditive);
                    }
                }
            } else if (worldUBO.skyType == 2 && surfaceDepth != INF_DISTANCE) {
                // The End's sky is its fog colour already (see the miss shader); fogging it again washed its
                // stars and gradient out to a flat sheet. The islands fade into the same violet.
                vec3 endFog = dot(max(worldUBO.fogColor.rgb, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722)) *
                              vec3(1.3, 0.8, 1.85) * 0.15;
                if (useTransparentSplit) {
                    applyFog(mainRay.radiance, surfaceDepth, worldUBO.fogStart, densityAir, densityFog,
                             endFog, mainRay.radiance, transparentFogTransmittance,
                             transparentFogAdditive);
                    transparentReflectionRadiance *= transparentFogTransmittance;
                    transparentRefractionRadiance *= transparentFogTransmittance;
                } else {
                    applyFog(mainRay.radiance, surfaceDepth, worldUBO.fogStart, densityAir, densityFog,
                             endFog, mainRay.radiance, composeFogTransmittance, composeFogAdditive);
                }
            }
        }
    }

    // With volumetric fog on, the overworld's biome fog is part of that march instead (see integrateVolumetricFog).
    if (!raySkipFog(mainRay) && skyUBO.hasBlindnessOrDarkness == 0 && biomeHazeActive()
        && !(useVolumetricFog && worldUBO.skyType == 1)) {
        float hazeTransmittance;
        vec3 hazeAdditive;
        // Only as far as the first surface: a ray carried on off water or glass is fogged on its own way (the miss
        // shader fogs the sky it ends in). Fogging the whole length at once hid the bottom of every pool that
        // reflected the sky.
        bool hazeHitSky = surfaceDepth == INF_DISTANCE;
        biomeHaze(orgDirection, hazeHitSky, hazeHitSky ? 0.0 : surfaceDepth, hazeTransmittance,
                  hazeAdditive);
        hazeAdditive *= fogGlassTint(hazeHitSky ? INF_DISTANCE : surfaceDepth);
        if (useTransparentSplit) {
            transparentReflectionRadiance *= hazeTransmittance;
            transparentRefractionRadiance *= hazeTransmittance;
            transparentFogAdditive = transparentFogAdditive * hazeTransmittance + hazeAdditive;
            transparentFogTransmittance *= hazeTransmittance;
        } else {
            mainRay.radiance = mainRay.radiance * hazeTransmittance + hazeAdditive;
            if (composeFogTransmittance < 0.0) {
                composeFogTransmittance = hazeTransmittance;
                composeFogAdditive = hazeAdditive;
            } else {
                composeFogAdditive = composeFogAdditive * hazeTransmittance + hazeAdditive;
                composeFogTransmittance *= hazeTransmittance;
            }
        }
    }

    if (useTransparentSplit) {
        // The denoiser's albedo guide for see-through glass is the colour light takes through it. Its texture albedo
        // times alpha was nearly black for clear glass and panes (alpha 0 where they are clear), and DLSS Ray
        // Reconstruction, dividing the picture by that guide, drew everything seen through them dark.
        vec3 transmissionGuide = clamp(viewGlassTint(firstHitMat.albedoValue.rgb, firstHitMat.albedoValue.a), 0.0, 1.0);
#if defined(VPT_BEDROCK_ORIGINAL) && VPT_BEDROCK_ORIGINAL != 0
        // Water has no surface colour filter; absorption is integrated in its medium.
        if (firstHitWaterSurface) { transmissionGuide = vec3(1.0); }
#endif
        imageStore(diffuseAlbedoImage, pixel, vec4(transmissionGuide, 0.0));
        firstHitEmission += transparentFogAdditive;
        mainRay.radiance = transparentReflectionRadiance + transparentRefractionRadiance + firstHitEmission;
#if defined(VPT_BEDROCK_ORIGINAL) && VPT_BEDROCK_ORIGINAL != 0
        // This replaces the radiance put together earlier: the glass's own reflection, traced apart, is put back
        // where the surface behind a pane is water. NRD takes it once through the emission image below.
        mainRay.radiance += glassReflectionRadiance;
#endif
        composeFogAdditive = vec3(0.0);
        composeFogTransmittance = -1.0;
    }

#if VPT_NRD_SIGNALS
    bool nrdSplit = false;
#endif
    if (!psrHitSky && isFirstHitNoisy) {
        if (useTransparentSplit) {
            imageStore(firstHitDiffuseDirectLightImage, ivec2(pixel), vec4(vec3(0.0), 1.0));
            imageStore(firstHitDiffuseIndirectLightImage, ivec2(pixel), vec4(vec3(0.0), 1.0));
            imageStore(firstHitSpecularImage, ivec2(pixel), vec4(storedRadiance(transparentReflectionRadiance), 1.0));
            imageStore(firstHitClearImage, ivec2(pixel), vec4(vec3(0.0), 0.0));
            imageStore(firstHitRefractionImage, ivec2(pixel),
                       vec4(storedRadiance(transparentRefractionRadiance), hasTransparentRefraction ? 1.0 : -1.0));
#if VPT_NRD_SIGNALS
        } else if (isFirstHitDiffuse || !isFirstHitTransparent) {
            // NRD's signals, apart (see clearNrdRecord): the glow goes to the channel NRD leaves as it is (the emission
            // image, below), where it stays sharp - in the diffuse signal it was blurred into a blob and then added a
            // second time; the direct light to the diffuse signal whichever lobe the bounce took (it used to go
            // wholly to the specular signal one frame in ten, which divided it by a reflectance of a few hundredths:
            // sparks on every lit wall); and the bounce's light to the signal of its lobe, with its length as the
            // hit distance NRD's diffuse filter is scaled by (none when it took the other lobe: NRD reconstructs it
            // from the neighbours).
            vec3 nrdBounce = max(mainRay.radiance - nrdFirstHitDirect - nrdEmission, vec3(0.0));
            float nrdHitDistance = hasSecondHit ? distFirstToSecond : NRD_MISS_HIT_DISTANCE;
            imageStore(firstHitDiffuseDirectLightImage, ivec2(pixel), vec4(storedRadiance(nrdFirstHitDirect), 1.0));
            imageStore(firstHitDiffuseIndirectLightImage, ivec2(pixel),
                       vec4(storedRadiance(isFirstHitDiffuse ? nrdBounce : vec3(0.0)),
                            isFirstHitDiffuse ? nrdHitDistance : 0.0));
            imageStore(firstHitSpecularImage, ivec2(pixel),
                       vec4(storedRadiance(isFirstHitDiffuse ? vec3(0.0) : nrdBounce), 1.0));
            imageStore(firstHitClearImage, ivec2(pixel), vec4(vec3(0.0), 0.0));
            imageStore(firstHitRefractionImage, ivec2(pixel), vec4(vec3(0.0), 0.0));
            nrdSplit = true;
#endif
        } else if (isFirstHitDiffuse) {
            imageStore(firstHitDiffuseDirectLightImage, ivec2(pixel), vec4(storedRadiance(firstHitDirectRadiance), 1.0));
            imageStore(firstHitDiffuseIndirectLightImage, ivec2(pixel), vec4(storedRadiance(firstHitIndirectRadiance), 1.0));
            imageStore(firstHitSpecularImage, ivec2(pixel), vec4(vec3(0.0), 1.0));
            imageStore(firstHitClearImage, ivec2(pixel), vec4(vec3(0.0), 0.0));
            imageStore(firstHitRefractionImage, ivec2(pixel), vec4(vec3(0.0), 0.0));
        } else if (isFirstHitRefraction) {
            imageStore(firstHitDiffuseDirectLightImage, ivec2(pixel), vec4(vec3(0.0), 1.0));
            imageStore(firstHitDiffuseIndirectLightImage, ivec2(pixel), vec4(vec3(0.0), 1.0));
            imageStore(firstHitSpecularImage, ivec2(pixel), vec4(vec3(0.0), 1.0));
            imageStore(firstHitClearImage, ivec2(pixel), vec4(vec3(0.0), 0.0));
            imageStore(firstHitRefractionImage, ivec2(pixel), vec4(storedRadiance(mainRay.radiance), 1.0));
        } else {
            imageStore(firstHitDiffuseDirectLightImage, ivec2(pixel), vec4(vec3(0.0), 1.0));
            imageStore(firstHitDiffuseIndirectLightImage, ivec2(pixel), vec4(vec3(0.0), 1.0));
            imageStore(firstHitSpecularImage, ivec2(pixel), vec4(storedRadiance(mainRay.radiance), 1.0));
            imageStore(firstHitClearImage, ivec2(pixel), vec4(vec3(0.0), 0.0));
            imageStore(firstHitRefractionImage, ivec2(pixel), vec4(vec3(0.0), isFirstHitTransparent ? -1.0 : 0.0));
        }
    } else {
        imageStore(firstHitDiffuseDirectLightImage, ivec2(pixel), vec4(vec3(0.0), 0.0));
        imageStore(firstHitDiffuseIndirectLightImage, ivec2(pixel), vec4(vec3(0.0), 0.0));
        imageStore(firstHitSpecularImage, ivec2(pixel), vec4(vec3(0.0), 0.0));
        imageStore(firstHitClearImage, ivec2(pixel), vec4(storedRadiance(mainRay.radiance), 1.0));
        imageStore(firstHitRefractionImage, ivec2(pixel), vec4(vec3(0.0), 0.0));
    }

    // Incident light meter, as Bedrock RTX meters: at the centre of each cell of a 16 x 16 grid, the light reaching
    // the surface seen there, as the brightness a white diffuse surface would have under it (the surface's own
    // colour divided out). Stored as the cube root per channel, for the power mean the exposure pass takes, and a
    // weight that fades distant surfaces out; the sky, glass, water and the hand count nothing.
    {
        ivec2 meterCell = max(ivec2(gl_LaunchSizeEXT.xy) / 16, ivec2(1));
        ivec2 meterIndex = pixel / meterCell;
        if (all(lessThan(meterIndex, ivec2(16))) && all(equal(pixel, meterIndex * meterCell + meterCell / 2))) {
            vec4 meterSample = vec4(0.0);
#if defined(VPT_BEDROCK_ORIGINAL) && VPT_BEDROCK_ORIGINAL != 0
            // As Bedrock RTX weights them: in full to 21/32 of the render distance, fading out to none at it (its
            // distance fade, calibrated to Bedrock RTX).
            float renderDistance = max(worldUBO.fogEnd, 32.0);
            float meterWeight = 1.0 - clamp(surfaceDepth * 32.0 / (11.0 * renderDistance) - 21.0 / 11.0, 0.0, 1.0);
#else
            float meterWeight = 1.0 - clamp((surfaceDepth - 32.0) / 96.0, 0.0, 1.0);
#endif
            vec3 white = vec3(-1.0); // Negative: no reading this frame.
            if (!psrHitSky && isFirstHitDiffuse && isHand == 0) {
                vec3 albedo = max(firstHitMat.albedoValue.rgb * firstHitMat.albedoValue.a, vec3(0.04));
                vec3 surfaceLight = firstHitDirectRadiance + firstHitIndirectRadiance;
#if defined(VPT_BEDROCK_ORIGINAL) && VPT_BEDROCK_ORIGINAL != 0
                // Bedrock meters the light falling on the surface, not the light it gives off: its own glow is no
                // part of it (a lamp in view read as bright as the glow it shows, not as the light it stands in).
                surfaceLight -= firstHitEmission;
#endif
                vec3 reading = max(surfaceLight / albedo, vec3(0.0));
                if (!any(isnan(reading)) && !any(isinf(reading))) { white = reading; }
            }
            uint meterSlot = uint(meterIndex.y * 16 + meterIndex.x);
#if defined(VPT_BEDROCK_ORIGINAL) && VPT_BEDROCK_ORIGINAL != 0
            // Bedrock meters the light its denoiser leaves, not one path's: each sample here is accumulated over the
            // frames its surface stays under the cell, as that denoiser accumulates - all of it on a surface just come
            // into view, 1/n of the way on its n-th frame, never less than a fiftieth (its diffuse temporal alpha,
            // calibrated to Bedrock RTX). The surface is the same while it faces the same way and lies on the same
            // plane within Bedrock's tolerance (0.025 blocks and half a percent of the distance). The cube roots of
            // single paths averaged low where the light comes in rare bright paths, and read the place darker.
            vec4 history = lightMeter.sampleHistory[meterSlot];
            vec4 historySurface = lightMeter.sampleSurface[meterSlot];
            if (!psrHitSky && isHand == 0 && isFirstHitNoisy && !useTransparentSplit) {
                vec3 axisSize = abs(firstHitNormal);
                int axisIndex = axisSize.x >= axisSize.y && axisSize.x >= axisSize.z ? 0 :
                                (axisSize.y >= axisSize.z ? 1 : 2);
                vec3 axis = vec3(0.0);
                axis[axisIndex] = firstHitNormal[axisIndex] > 0.0 ? 1.0 : -1.0;
                float axisCode = float(axisIndex * 2 + (axis[axisIndex] > 0.0 ? 1 : 2));
                vec3 previousPoint = historySurface.xyz - cameraDelta;
                bool kept = history.w >= 1.0 && history.w <= 100.0 && historySurface.w == axisCode &&
                            !any(isnan(history)) && !any(isinf(history)) && !any(isnan(previousPoint)) &&
                            abs(dot(axis, firstHitWorldPos - previousPoint)) <= 0.005 * surfaceDepth + 0.025;
                if (white.x >= 0.0) {
                    float frames = kept ? min(history.w + 1.0, 100.0) : 1.0;
                    vec3 accumulated = kept ? mix(history.rgb, white, max(1.0 / frames, 0.02)) : white;
                    lightMeter.sampleHistory[meterSlot] = vec4(accumulated, frames);
                    lightMeter.sampleSurface[meterSlot] = vec4(firstHitWorldPos, axisCode);
                    meterSample = vec4(exp2(log2(max(accumulated, vec3(1e-12))) / 3.0), meterWeight);
                } else if (kept) {
                    // This frame's path took the surface's reflection, which says nothing of the light on it: the
                    // light gathered so far stands in.
                    meterSample = vec4(exp2(log2(max(history.rgb, vec3(1e-12))) / 3.0), meterWeight);
                } else {
                    lightMeter.sampleHistory[meterSlot] = vec4(0.0);
                }
            } else {
                lightMeter.sampleHistory[meterSlot] = vec4(0.0);
            }
            lightMeter.samples[meterSlot] = meterSample;
#else
            if (white.x >= 0.0) { meterSample = vec4(exp2(log2(max(white, vec3(1e-12))) / 3.0), meterWeight); }
            // Averaged over frames: each sample is one noisy path, and the meter shimmered with it.
            vec4 previousSample = lightMeter.samples[meterSlot];
            bool usable = !any(isnan(previousSample)) && !any(isinf(previousSample));
            lightMeter.samples[meterSlot] = usable ? mix(previousSample, meterSample, 0.2) : meterSample;
#endif
        }
        // How much of a day it is, by the sun's height: the eye may open far by day (a room, a cave) but not at
        // night, which is meant to stay dark. Other dimensions have no night.
        if (all(equal(pixel, ivec2(0)))) {
            // The End is a dark place by design: the eye stays as at night there, or its dim void was opened up to
            // a pale pink glare.
            // The Nether too: lit by lava alone, the eye let open by day brought its fog up to a flat pink sky.
            float day = worldUBO.skyType == 1 ? smoothstep(-0.05, 0.15, celestialSunDirection().y) : 0.0;
            // And how dark the place is meant to look: the End is kept well below what the meter would bring it
            // to, a dim world against a near-black void as in vanilla.
            float darkness = worldUBO.skyType == 2 ? END_EXPOSURE_SCALE : (worldUBO.skyType == 0 ? NETHER_EXPOSURE_SCALE : 1.0);
            // z: the camera is under water. The eye holds the exposure it had there (exposure.comp): the water
            // darkens with depth on its own (water_medium.glsl), and an eye adapting to it brought the brightness
            // back as the camera sank - dimming, then opening up again.
#if defined(VPT_BEDROCK_ORIGINAL) && VPT_BEDROCK_ORIGINAL != 0
            // Bedrock RTX's eye goes on metering under water: going in from a sunny pool, its picture brightens by
            // about a stop over a second and a half (observed), and the water reads a bright blue.
            float underWater = 0.0;
#else
            float underWater = skyUBO.cameraSubmersionType == 1 ? 1.0 : 0.0;
#endif
            // The picture a little under what the meter brings it to, by day and by night (settings); w: how far the
            // eye may open by day at most, so a sealed room stays dark instead of being opened up to its faint
            // leftover light.
#if !defined(VPT_BEDROCK_ORIGINAL) || VPT_BEDROCK_ORIGINAL == 0
            // (The experimental Bedrock profile exposes as Bedrock RTX does, with no offset of its own.)
            darkness *= mix(VPT_EXPOSURE_NIGHT_SCALE, VPT_EXPOSURE_DAY_SCALE, day);
#else
            // By day a little under Bedrock's: with the sun's light cut (shadow.rmiss) the meter alone opened the eye
            // back up and the picture came out as bright as before, only flatter; held under, daylight is softer.
            darkness *= mix(1.0, BEDROCK_DAY_EXPOSURE_SCALE, day);
#endif
            // w: a negative one marks the Nether for the tone mapper (exposure.comp); the other dimensions' day maximum.
            lightMeter.daylight = vec4(day, darkness, underWater, worldUBO.skyType == 0 ? -1.0 : VPT_EXPOSURE_DAY_MAX);
        }
    }

    // Night vision brightens Minecraft's lightmap, and a path tracer reads no lightmap, so the effect did nothing
    // at all: a cave stayed as black with it as without. The surface the camera sees gets a flat term of its own
    // colour instead, which is how the lightmap's floor reads in vanilla - everything visible, washed out, no
    // shadows of its own. It goes into the emission channel, which the NRD compose reads and leaves undenoised,
    // and onto the radiance below, which is what DLSS Ray Reconstruction is handed; neither pass reads both.
    vec3 nightVisionAmbient = vec3(0.0);
#if defined(VPT_BEDROCK_ORIGINAL) && VPT_BEDROCK_ORIGINAL != 0
    // Bedrock RTX's ambient, added to the light on the surface in view before the surface's colour multiplies it:
    // 5 a (0.2 + 0.8 (N.V)^1.1) on the scale Bedrock works at (2^bedrockMeter.y), most where the surface faces the
    // camera. a is night vision's strength, with a floor of its own in a dark place: none while the metered level
    // is under 10 stops from 0.75, rising to 0.05 at 14 - a room lit by one torch is seen by a faint, grey glow from
    // where the player stands. (Bedrock RTX's own equation and constants.)
    vec4 bedrockMeter = lightMeter.bedrockMeter;
    if (!hitSky && !useTransparentSplit && bedrockMeter.w == 1.0) {
        float darkFloor = clamp(0.25 * bedrockMeter.x - 2.5, 0.0, 1.0) * 0.05;
        float ambientLevel = skyUBO.nightVision * (1.0 - darkFloor) + darkFloor;
        float facing = pow(max(dot(-firstHitIncomingDirection, firstHitNormal), 0.0), 1.1);
        nightVisionAmbient = firstHitMat.albedoValue.rgb * firstHitMat.albedoValue.a * (1.0 - firstHitMat.metallic) *
                             (5.0 * ambientLevel * (0.2 + 0.8 * facing) * exp2(-bedrockMeter.y));
    }
#else
    if (skyUBO.nightVision > 0.0 && !hitSky) {
        nightVisionAmbient = skyUBO.nightVision * NIGHT_VISION_AMBIENT * firstHitMat.albedoValue.rgb *
                             firstHitMat.albedoValue.a;
    }
#endif
#if VPT_NRD_SIGNALS
    // The glow the surface was seen with, as the closest hit added it.
    if (nrdSplit) { firstHitEmission = nrdEmission; }
#endif
    firstHitEmission += nightVisionAmbient;
    if (skyUBO.hasBlindnessOrDarkness > 0 && composeFogTransmittance >= 0.0) {
        // The emission channel skips the fog above; without this, glowing blocks shone through the dark.
        firstHitEmission *= composeFogTransmittance;
    }
    if (!psrHitSky) { firstHitEmission += glassReflectionRadiance; }
    imageStore(firstHitBaseEmissionImage, ivec2(pixel), vec4(firstHitEmission, 1.0));
#if defined(VPT_BEDROCK_ORIGINAL) && VPT_BEDROCK_ORIGINAL != 0
    if (composeFogIsRgb) { composeFogTransmittance = -2.0; }
#endif
    bool applyVolumetricCompose =
        useVolumetricFog && !raySkipFog(mainRay) && skyUBO.cameraSubmersionType != 1 && worldUBO.skyType == 1 &&
        skyUBO.hasBlindnessOrDarkness == 0;
    if (applyVolumetricCompose) {
        // Only as far as the first surface, as the biome haze: a ray carried on off water or glass crosses its own
        // air, and marching the whole reflected or refracted length hid every pool under a white wall of fog.
        float volumetricDistance = surfaceDepth == INF_DISTANCE ? volumetricMediumMaxDistance() : surfaceDepth;
        vec3 volumetricTransmittance;
        vec3 volumetricLight;
        float biomeReach =
            biomeFogReach(orgDirection, surfaceDepth == INF_DISTANCE, surfaceDepth == INF_DISTANCE ? 0.0 : surfaceDepth);
#if VPT_FROXEL_ACTIVE
        froxelFog(eyePos, orgDirection, pixelCenter / resolution, volumetricDistance, biomeReach,
                  surfaceDepth == INF_DISTANCE, volumetricTransmittance, volumetricLight);
#else
        integrateVolumetricFog(eyePos, orgDirection, volumetricDistance, biomeReach, rayInsideBoat(mainRay),
                               volumetricTransmittance, volumetricLight);
#endif
        volumetricLight *= fogGlassTint(volumetricDistance);
        mainRay.radiance = mainRay.radiance * volumetricTransmittance + volumetricLight;
#if defined(VPT_BEDROCK_ORIGINAL) && VPT_BEDROCK_ORIGINAL != 0 && VPT_BEDROCK_FOG != 0
        composeFogTransmissionRGB = volumetricTransmittance * (composeFogTransmittance < 0.0 ? 1.0 : composeFogTransmittance);
        composeFogAdditive = (composeFogTransmittance < 0.0 ? vec3(0.0) : composeFogAdditive * volumetricTransmittance) + volumetricLight;
        // -1 means no fog; -2 explicitly selects RGB transmission in compose, preserving legacy packs.
        composeFogTransmittance = -2.0;
#else
        if (!useTransparentSplit) {
            // Folded into whatever fog is already composed (the biome haze) rather than replacing it.
            float volumetricComposeTransmittance = clamp(volumetricLightLuminance(volumetricTransmittance), 0.0, 1.0);
            if (composeFogTransmittance < 0.0) {
                composeFogTransmittance = volumetricComposeTransmittance;
                composeFogAdditive = volumetricLight;
            } else {
                composeFogAdditive = composeFogAdditive * volumetricComposeTransmittance + volumetricLight;
                composeFogTransmittance *= volumetricComposeTransmittance;
            }
        }
#endif
    }
    bool isFirstHitSpecular = useTransparentSplit ? hasTransparentReflection :
                                                    (isFirstHitNoisy && !isFirstHitDiffuse && !isFirstHitRefraction);
    float specHitDepth = 0.0;
    if (useTransparentSplit) {
        specHitDepth = hasTransparentReflection ?
                           (hasTransparentReflectionSecondHit ? transparentReflectionSecondHitDistance : INF_DISTANCE) :
                           0.0;
    } else {
        specHitDepth = isFirstHitSpecular ? (hasSecondHit ? distFirstToSecond : INF_DISTANCE) : 0.0;
    }
    imageStore(fogImage, ivec2(pixel), vec4(composeFogAdditive, composeFogTransmittance));
    imageStore(fogTransmissionImage, ivec2(pixel), vec4(composeFogTransmissionRGB, 1.0));
    imageStore(postStarCloudTransmittanceImage, ivec2(pixel), vec4(postStarCloudTransmittance));
    imageStore(specularHitDepthImage, ivec2(pixel), vec4(specHitDepth, vec3(1.0)));
#    if SHARC_QUERY && USE_SHARC
    if (sharcConfig.debugMode == 1u && !psrHitSky) {
        vec3 debugPosWorld = psrHitPosition + vec3(worldUBO.cameraPos.xyz);
        vec3 debugNormal = vec3(0.0, 1.0, 0.0);
        mainRay.radiance = HashGridDebugColoredHash(debugPosWorld, debugNormal, sharcParameters.gridParameters);
    } else if (sharcConfig.debugMode == 2u) {
        mainRay.radiance =
            HashGridDebugOccupancy(uvec2(pixel), uvec2(imageSize(outputImage)), sharcParameters.hashMapData);
    } else if (sharcConfig.debugMode == 3u) {
        float t = clamp(float(sharcDebugBounceCount) / max(float(VPT_NUM_RAY_BOUNCES), 1.0), 0.0, 1.0);
        vec3 heat = mix(vec3(0.0, 0.8, 0.0), vec3(1.0, 0.0, 0.0), t);
        if (sharcDebugCacheHit) { heat = vec3(0.0, 0.5, 1.0); }
        mainRay.radiance = heat;
    }
#    endif
    vec3 glowColor;
    if (worldUBO.hasGlowOutline != 0u && glowOutline(pixelCenter, resolution, eyePos, glowColor)) {
        // Written over everything the pixel held, into both what DLSS Ray Reconstruction reads and the NRD
        // compose's clear channel, which it passes through untouched.
        vec3 glowRadiance = glowColor * GLOW_OUTLINE_RADIANCE;
        imageStore(firstHitClearImage, ivec2(pixel), vec4(glowRadiance, 1.0));
        imageStore(diffuseAlbedoImage, ivec2(pixel), vec4(glowColor, 0.0));
        imageStore(specularAlbedoImage, ivec2(pixel), vec4(0.0));
#if defined(VPT_BEDROCK_ORIGINAL) && VPT_BEDROCK_ORIGINAL != 0
        imageStore(fogImage, ivec2(pixel), vec4(0.0, 0.0, 0.0, -1.0));
#endif
        imageStore(outputImage, ivec2(pixel), vec4(glowRadiance, 1.0));
        return;
    }
    imageStore(outputImage, ivec2(pixel), vec4(mainRay.radiance + nightVisionAmbient, 1.0));
#endif
}
