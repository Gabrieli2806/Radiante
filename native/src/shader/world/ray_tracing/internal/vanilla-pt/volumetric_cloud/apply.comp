#version 460
#extension GL_GOOGLE_include_directive : require

// Writes the temporally resolved volumetric clouds into the frame: the raw cloud radiance goes to the first-hit
// image, the fog-composed radiance to the output, and the cloud transmittance to the post pass that draws the stars
// (so stars dim behind clouds). Pixels with no cloud sample (negative alpha) are left untouched.

#include "common/shared.hpp"
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 3, binding = 0, rgba16f) uniform image2D outputImage;
layout(set = 3, binding = 11, rgba16f) uniform image2D firstHitClearImage;
layout(set = 3, binding = 13, rgba16f) uniform readonly image2D fogImage;
layout(set = 3, binding = 15, rgba16f) uniform readonly image2D fogTransmissionImage;
layout(set = 5, binding = 32, r16f) uniform image2D postStarCloudTransmittanceImage;
layout(set = 5, binding = 34, rgba16f) uniform readonly image2D volumetricCloudTemporalImage;

bool finiteFloat(float value) {
    return !isnan(value) && !isinf(value);
}

bool finiteVec3(vec3 value) {
    return !any(isnan(value)) && !any(isinf(value));
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(texel, imageSize(outputImage)))) { return; }

    vec4 cloud = imageLoad(volumetricCloudTemporalImage, texel);
    bool cloudUsable = cloud.a >= 0.0 && finiteVec3(cloud.rgb) && finiteFloat(cloud.a);
    if (!cloudUsable) { return; }
    vec3 cloudRadiance = max(cloud.rgb, vec3(0.0));

    // Fog alpha: -2 means a per-channel transmittance lives in its own image, a value >= 0 is a grey transmittance,
    // anything else (or NaN/Inf) means no fog over this pixel.
    vec4 fog = imageLoad(fogImage, texel);
    bool colouredFog = fog.a == -2.0;
    bool hasFog = finiteFloat(fog.a) && (colouredFog || fog.a >= 0.0);
    vec3 transmittance;
    if (colouredFog) {
        transmittance = clamp(imageLoad(fogTransmissionImage, texel).rgb, 0.0, 1.0);
    } else {
        transmittance = vec3(hasFog ? clamp(fog.a, 0.0, 1.0) : 1.0);
    }
    vec3 inscatter = (hasFog && finiteVec3(fog.rgb)) ? max(fog.rgb, vec3(0.0)) : vec3(0.0);

    imageStore(firstHitClearImage, texel, vec4(cloudRadiance, 1.0));
    imageStore(outputImage, texel, vec4(cloudRadiance * transmittance + inscatter, 1.0));
    imageStore(postStarCloudTransmittanceImage, texel, vec4(clamp(cloud.a, 0.0, 1.0)));
}
