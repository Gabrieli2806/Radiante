#version 460

// The Bedrock-style tone curve, rebuilt each frame from the histogram of bedrock_hist.comp; an independent
// approximation of how the game behaves.
//
//  * Every bin gets a slope: output bins per input bin. The bins split at log2 luminance -2.45 into shadows and
//    highlights, and each part has a fixed output budget, the highlights 2.47 stops and the shadows the rest of the
//    dynamic range. Within a part the budget is shared out in proportion to how much of the picture each bin holds,
//    at most 1 per bin, by water filling (16 refinements).
//  * The curve is the running sum of the slopes, placed so the brightest bin maps to white (log2 0).
//  * Then the shadows below shadowContrastEnd are deepened, no luminance may be lifted by more than
//    maxExposureIncrease stops, and the curve is smoothed over 25 bins, shifted by curveShift and eased in over time.
//
// One group of 256 invocations, one per bin. Result: bedrock.curve[i] is the log2 of the displayed luminance for
// input log2 luminance -24 + i * 28 / 256. The histogram is cleared for the next frame.
#define BIN_COUNT 256
const float LOG2_MIN = -24.0;
const float BIN_STOPS = 28.0 / 256.0;
const uint SPLIT_BIN = 197u;
const float HIGHLIGHT_STOPS = 2.473931;
const float MIN_DYNAMIC_RANGE = 2.556393;
const float WEIGHT_STEPS = 64.0;
const uint SMOOTH_RADIUS = 12u;
const float HISTORY_KEEP = 0.9323938;

layout(std430, set = 0, binding = 4) buffer BedrockCurveBuffer {
    uint histogram[BIN_COUNT];
    float curve[BIN_COUNT];
}
bedrock;

// ToneMappingBedrockCurvePushConstant (tone_mapping_module.hpp).
layout(push_constant) uniform PushConstant {
    float dynamicRange;
    float curveShift;
    float maxExposureIncrease;
    float shadowMinSlope;
    float shadowContrast;
    float shadowContrastEnd;
    int needsReset; // the curve held so far is not to be eased from
    int autoExposure;
    float manualExposure;
    float exposureBias;
}
pc;

layout(local_size_x = BIN_COUNT, local_size_y = 1, local_size_z = 1) in;

shared float scratch[BIN_COUNT];

// The sum of value over the group, by halving (every invocation gets it).
float groupSum(float value) {
    uint i = gl_LocalInvocationIndex;
    scratch[i] = value;
    barrier();
    for (uint stride = BIN_COUNT / 2u; stride > 0u; stride >>= 1u) {
        if (i < stride) { scratch[i] += scratch[i + stride]; }
        barrier();
    }
    float sum = scratch[0];
    barrier();
    return sum;
}

// The running sum of value up to and including this invocation (Hillis-Steele). Leaves every invocation's running sum
// in scratch.
float groupInclusiveScan(float value) {
    uint i = gl_LocalInvocationIndex;
    scratch[i] = value;
    barrier();
    for (uint offset = 1u; offset < BIN_COUNT; offset <<= 1u) {
        float addend = i >= offset ? scratch[i - offset] : 0.0;
        barrier();
        scratch[i] += addend;
        barrier();
    }
    return scratch[i];
}

// This bin's slope within its part of the curve: the part's budget (in bins) shared out by water filling. weight is
// the bin's share of the picture, 0 for bins outside the part.
float partSlope(float weight, float budget) {
    float share = weight / groupSum(weight);
    float inverseShare = share > 0.0 ? 1.0 / share : 0.0;
    float level = 1e-16;
    for (int refinement = 0; refinement < 16; refinement++) {
        float above = share < level ? 0.0 : 1.0;
        float aboveCount = groupSum(above);
        float aboveInverse = groupSum(above * inverseShare);
        level = (aboveCount - budget) / aboveInverse;
    }
    float above = share < level ? 0.0 : 1.0;
    float aboveCount = groupSum(above);
    float aboveInverse = groupSum(above * inverseShare);
    return above * (1.0 + (budget - aboveCount) * inverseShare / aboveInverse);
}

void main() {
    uint i = gl_LocalInvocationIndex;
    float x = LOG2_MIN + float(i) * BIN_STOPS;
    // Every bin holds a little, so that a part of the curve with nothing in it still gets a shape.
    float weight = float(bedrock.histogram[i]) / WEIGHT_STEPS + 1.0;

    float range = max(pc.dynamicRange, MIN_DYNAMIC_RANGE);
    float shadowBudget = (range - HIGHLIGHT_STOPS) / BIN_STOPS;
    float highlightBudget = HIGHLIGHT_STOPS / BIN_STOPS;

    bool shadowBin = i < SPLIT_BIN;
    float shadowSlope = partSlope(shadowBin ? weight : 0.0, shadowBudget);
    float highlightSlope = partSlope(shadowBin ? 0.0 : weight, highlightBudget);
    float slope = shadowBin ? max(shadowSlope, pc.shadowMinSlope) : highlightSlope;

    float inclusive = groupInclusiveScan(slope);
    float total = scratch[BIN_COUNT - 1u];
    barrier();
    float y = (inclusive - slope - total) * BIN_STOPS;
    y -= max(pc.shadowContrastEnd - x, 0.0) * pc.shadowContrast;
    y = min(y, x + pc.maxExposureIncrease);

    // A box filter over the neighbouring bins, as the difference of two running sums. (Near the dark end the window
    // starts at bin 1: bin 0 is left out.)
    groupInclusiveScan(y);
    uint hi = min(i + SMOOTH_RADIUS, BIN_COUNT - 1u);
    uint lo = uint(max(int(i) - int(SMOOTH_RADIUS) - 1, 0));
    float smoothed = (scratch[hi] - scratch[lo]) / float(hi - lo) + pc.curveShift;

    float previous = bedrock.curve[i];
    bool keepHistory = pc.needsReset == 0 && !isnan(previous) && !isinf(previous);
    bedrock.curve[i] = keepHistory ? smoothed + (previous - smoothed) * HISTORY_KEEP : smoothed;
    bedrock.histogram[i] = 0u;
}
