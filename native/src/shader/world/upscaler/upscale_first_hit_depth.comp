#version 460

// Resamples the first-hit depth from the render resolution to the output resolution. Smooth areas are filtered
// bilinearly; across a depth edge the nearest of the four source depths is kept instead, since blending a
// foreground and a background depth would invent a surface floating in between.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, r16f) uniform readonly image2D firstHitDepthIn;
layout(set = 0, binding = 1, r16f) uniform writeonly image2D firstHitDepthOut;

layout(push_constant) uniform DepthUpscaleParams {
    float scaleX;
    float scaleY;
    uint srcWidth;
    uint srcHeight;
    uint dstWidth;
    uint dstHeight;
} params;

// Source depth with the coordinate clamped to the source image.
float fetchSourceDepth(ivec2 texel) {
    texel = clamp(texel, ivec2(0), ivec2(int(params.srcWidth) - 1, int(params.srcHeight) - 1));
    return imageLoad(firstHitDepthIn, texel).r;
}

void main() {
    uvec2 dst = gl_GlobalInvocationID.xy;
    if (dst.x >= params.dstWidth || dst.y >= params.dstHeight) {
        return;
    }

    // This output pixel's centre, in source texel space (texel centres at integers after the half shift).
    vec2 dstUv = (vec2(dst) + 0.5) / vec2(params.dstWidth, params.dstHeight);
    vec2 srcPos = dstUv * vec2(params.srcWidth, params.srcHeight) - 0.5;
    ivec2 lo = ivec2(floor(srcPos));
    ivec2 hi = lo + ivec2(1);
    vec2 weight = fract(srcPos);

    float depthLL = fetchSourceDepth(lo);
    float depthHL = fetchSourceDepth(ivec2(hi.x, lo.y));
    float depthLH = fetchSourceDepth(ivec2(lo.x, hi.y));
    float depthHH = fetchSourceDepth(hi);

    float nearest = min(min(depthLL, depthHL), min(depthLH, depthHH));
    float farthest = max(max(depthLL, depthHL), max(depthLH, depthHH));

    float rowLow = mix(depthLL, depthHL, weight.x);
    float rowHigh = mix(depthLH, depthHH, weight.x);
    float filtered = mix(rowLow, rowHigh, weight.y);

    // An edge: the four depths spread more than half a block, or 2% of the nearest, whichever is larger.
    float edgeSpread = max(0.5, nearest * 0.02);
    float result = (farthest - nearest) > edgeSpread ? nearest : filtered;

    imageStore(firstHitDepthOut, ivec2(dst), vec4(result, 0.0, 0.0, 0.0));
}
