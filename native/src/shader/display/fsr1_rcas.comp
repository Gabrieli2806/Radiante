#version 460

// Output resolution (render/output_upscaler.cpp), second pass: AMD FidelityFX Super Resolution 1 RCAS (robust
// contrast adaptive sharpening) of the EASU result, written at the window's size. The algorithm is the FidelityFX
// SDK's own (extern/FidelityFX-SDK, MIT licensed); only its inputs and outputs are wired here.

#extension GL_GOOGLE_include_directive : require

#define FFX_GPU 1
#define FFX_GLSL 1
#define FFX_HALF 0
#define FSR_RCAS_F 1

#include "FidelityFX/gpu/ffx_core.h"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D upscaled;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D sharpened;

layout(push_constant) uniform RcasParams {
    uvec2 size;
    // In stops: 0 is the strongest sharpening, each stop halves it.
    float sharpness;
} params;

FfxFloat32x4 FsrRcasLoadF(FfxInt32x2 p) {
    // RCAS reads a cross around each pixel; clamped, the edges repeat their last row and column.
    return imageLoad(upscaled, clamp(p, ivec2(0), ivec2(params.size) - 1));
}

void FsrRcasInputF(inout FfxFloat32 r, inout FfxFloat32 g, inout FfxFloat32 b) {}

#include "FidelityFX/gpu/fsr1/ffx_fsr1.h"

void filterPixel(uvec2 pixel, uvec4 con) {
    if (any(greaterThanEqual(pixel, params.size))) { return; }
    vec3 color;
    FsrRcasF(color.r, color.g, color.b, pixel, con);
    imageStore(sharpened, ivec2(pixel), vec4(color, 1.0));
}

void main() {
    // FsrRcasCon: only its first word is read by the 32-bit filter.
    uvec4 con = uvec4(floatBitsToUint(exp2(-params.sharpness)), 0u, 0u, 0u);

    uvec2 pixel = ffxRemapForQuad(gl_LocalInvocationID.x) + uvec2(gl_WorkGroupID.x << 4u, gl_WorkGroupID.y << 4u);
    filterPixel(pixel, con);
    pixel.x += 8u;
    filterPixel(pixel, con);
    pixel.y += 8u;
    filterPixel(pixel, con);
    pixel.x -= 8u;
    filterPixel(pixel, con);
}
