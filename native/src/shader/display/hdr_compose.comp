#version 460

// HDR display output (render/hdr_output.cpp): Minecraft's final image, composed for a 16-bit float scRGB swapchain,
// where 1.0 is 80 nits, linear, with sRGB primaries.
//
// Tone mapping (selected curve, Bedrock grade, Nether hue shoulder and bloom) and the post render passes (stars,
// motion blur, depth of field and shader pack post grading) have already run in 16-bit float, keeping values <= 1.0
// identical to SDR and extending highlights up to pow(peak, 1 / 2.2).
//
// A pixel where Minecraft drew nothing opaque or coloured over the fused world (only leaving it as is, or darkening it
// with a grey overlay such as vanilla's vignette) shows that HDR world picture at paper white, reaching up to peak.
// Everything else (menus, text, hotbar, coloured overlays, or the whole screen when no world was traced) shows
// Minecraft's SDR image at paper white.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D shownImage;      // Minecraft's final image, UI included; gamma 2.2
layout(set = 0, binding = 1) uniform sampler2D fusedWorld;      // the world image fused into shownImage
layout(set = 0, binding = 2) uniform sampler2D toneMappedWorld; // tone mapped HDR/SDR, before post render passes
layout(set = 0, binding = 3) uniform sampler2D worldOutput;     // final pipeline picture, after post render passes
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D composed;

layout(push_constant) uniform ComposeParams {
    float paperWhite;  // the scRGB value of SDR white (nits / 80)
    float peak;        // the display's peak brightness, in paper whites (at least 1)
    int worldValid;
    int debugView;     // tints what is shown as SDR, to tell it from what is HDR
    int scaled;        // the world images are at a lower output resolution than shownImage
    int calibration;   // the HDR calibration screen: 0 off, 1 peak pattern in rectA, 2 pictures in rectA and rectB
    float testLevel;   // the scRGB value of the peak pattern's marks
    float padding;
    vec4 rectA;        // x, y, width, height, as fractions of the image
    vec4 rectB;
} params;

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

// Allow up to three quarters of an 8-bit step so tie-breaking differences in float->UNORM blit rounding still match.
const float STEP_TOLERANCE = 0.75 / 255.0;

bool sameStored(vec3 a, vec3 b) {
    return all(lessThanEqual(abs(a - b), vec3(STEP_TOLERANCE)));
}

float largest(vec3 v) {
    return max(v.r, max(v.g, v.b));
}

// How far `shown` is `worldSdr` darkened by a grey overlay: 1 where nothing was drawn over the world, the grey (0.2..1)
// where an overlay multiplied it, 0 where it is anything else.
float greyShade(vec3 shown, vec3 worldSdr) {
    if (sameStored(shown, worldSdr)) { return 1.0; }
    float worldTop = largest(worldSdr);
    if (worldTop < 16.0 / 255.0) { return 0.0; }
    float factor = largest(shown) / worldTop;
    if (factor > 1.0 + 1.0 / 255.0 || factor < 0.2) { return 0.0; }
    return all(lessThanEqual(abs(shown - worldSdr * factor), vec3(1.5 / 255.0))) ? min(factor, 1.0) : 0.0;
}

vec3 encodedToScRgb(vec3 encoded) {
    return pow(max(encoded, vec3(0.0)), vec3(2.2)) * params.paperWhite;
}

// Bilinear filtering by hand: the samplers here fetch nearest, which the unscaled path relies on.
vec3 bilinear(sampler2D image, vec2 uv) {
    ivec2 size = textureSize(image, 0);
    vec2 position = uv * vec2(size) - 0.5;
    ivec2 base = ivec2(floor(position));
    vec2 f = position - vec2(base);
    ivec2 high = size - 1;
    vec3 a = texelFetch(image, clamp(base, ivec2(0), high), 0).rgb;
    vec3 b = texelFetch(image, clamp(base + ivec2(1, 0), ivec2(0), high), 0).rgb;
    vec3 c = texelFetch(image, clamp(base + ivec2(0, 1), ivec2(0), high), 0).rgb;
    vec3 d = texelFetch(image, clamp(base + ivec2(1, 1), ivec2(0), high), 0).rgb;
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

vec3 bilinearClamped(sampler2D image, vec2 uv) {
    ivec2 size = textureSize(image, 0);
    vec2 position = uv * vec2(size) - 0.5;
    ivec2 base = ivec2(floor(position));
    vec2 f = position - vec2(base);
    ivec2 high = size - 1;
    vec3 a = clamp(texelFetch(image, clamp(base, ivec2(0), high), 0).rgb, vec3(0.0), vec3(1.0));
    vec3 b = clamp(texelFetch(image, clamp(base + ivec2(1, 0), ivec2(0), high), 0).rgb, vec3(0.0), vec3(1.0));
    vec3 c = clamp(texelFetch(image, clamp(base + ivec2(0, 1), ivec2(0), high), 0).rgb, vec3(0.0), vec3(1.0));
    vec3 d = clamp(texelFetch(image, clamp(base + ivec2(1, 1), ivec2(0), high), 0).rgb, vec3(0.0), vec3(1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

bool inside(vec2 uv, vec4 rect) {
    return all(greaterThanEqual(uv, rect.xy)) && all(lessThan(uv, rect.xy + rect.zw));
}

// Marks at the level under test, on the most scRGB asks of any display (10000 nits). A display clips both to its own
// peak, so the marks vanish once the level under test reaches it.
vec3 peakPattern(vec2 uv) {
    const float CELLS = 7.0;
    const float BACKGROUND = 125.0;
    ivec2 cell = ivec2((uv - params.rectA.xy) / params.rectA.zw * CELLS);
    bool mark = (cell.x & 1) == 1 && (cell.y & 1) == 1;
    return vec3(mark ? params.testLevel : BACKGROUND);
}

// A screenshot's highlights back above SDR white for the calibration preview images.
vec3 pictureToScRgb(vec3 encoded) {
    const float shoulderStart = 0.76;
    const float headroom = 1.0 - shoulderStart;
    vec3 color = pow(max(encoded, vec3(0.0)), vec3(2.2));
    float top = largest(color);
    if (top < shoulderStart) { return color * params.paperWhite; }
    float radiance = headroom * headroom / (1.0 - min(top, 0.995)) - headroom + shoulderStart;
    float peak = max(params.peak, 1.0);
    float peakRoom = peak - shoulderStart;
    float newTop = peak - peakRoom * peakRoom / (radiance + peakRoom - shoulderStart);
    return color * (newTop / top) * params.paperWhite;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(composed)))) { return; }

    vec3 shown = texelFetch(shownImage, pixel, 0).rgb;
    vec3 result = encodedToScRgb(shown);
    bool fromWorldHdr = false;

    if (params.worldValid != 0) {
        vec3 fusedRaw = texelFetch(fusedWorld, pixel, 0).rgb;
        vec3 fusedSdr = clamp(fusedRaw, vec3(0.0), vec3(1.0));
        // Minecraft's target is 8-bit UNORM: compare against the rounded 8-bit value that the fuse blit stored.
        vec3 fused8 = round(fusedSdr * 255.0) / 255.0;
        float shade = greyShade(shown, fused8);
        if (shade > 0.0) {
            vec2 uv = (vec2(pixel) + 0.5) / vec2(imageSize(composed));
            vec3 hdrEncoded = params.scaled != 0 ? bilinear(worldOutput, uv) : texelFetch(worldOutput, pixel, 0).rgb;
            // A pack's grade that clips at 1.0 has its headroom restored where it clips (post_hook_grade.frag). A
            // second restore here, by comparing with the picture before the post passes, also fired where depth of
            // field or motion blur happened to average a lamp down to about 1.0, and drew speckled halos.

            if (!any(isnan(hdrEncoded)) && !any(isinf(hdrEncoded))) {
                float maxLinear = max(params.peak, 1.0);
                vec3 linearWorld = min(pow(max(hdrEncoded, vec3(0.0)), vec3(2.2)), vec3(maxLinear));
                result = linearWorld * params.paperWhite * pow(shade, 2.2);
                if (params.scaled != 0) {
                    // Carry over the FSR 1 RCAS sharpening detail from the scaled fuse image.
                    float filtered = dot(pow(bilinearClamped(worldOutput, uv), vec3(2.2)), LUMA);
                    float sharp = dot(pow(fusedSdr, vec3(2.2)), LUMA);
                    result *= filtered > 1.0e-4 ? clamp(sharp / filtered, 0.5, 2.0) : 1.0;
                }
                fromWorldHdr = true;
            }
        }
    }

    if (params.calibration != 0) {
        vec2 uv = (vec2(pixel) + 0.5) / vec2(imageSize(composed));
        if (inside(uv, params.rectA) && params.calibration == 1) {
            result = peakPattern(uv);
            fromWorldHdr = true;
        } else if (params.calibration == 2 && (inside(uv, params.rectA) || inside(uv, params.rectB))) {
            result = pictureToScRgb(shown);
            fromWorldHdr = true;
        }
    }

    if (params.debugView != 0 && !fromWorldHdr) { result = vec3(0.25, 0.45, 1.0) * dot(result, LUMA); }

    imageStore(composed, pixel, vec4(result, 1.0));
}
