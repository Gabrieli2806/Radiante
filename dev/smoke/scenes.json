  "toggles": [
    {
      "name": "ray_tracing",
      "what": "Radiante's picture against Minecraft's own: they must differ.",
      "view": [
        "cmd=/radiante showcase 8"
      ],
      "off": [
        "rt=false"
      ],
      "on": [
        "rt=true"
      ],
      "settle_ticks": 120
    },
    {
      "name": "volumetric_fog",
      "what": "Light shafts and fog in the air.",
      "view": [
        "cmd=/radiante showcase 1",
        "cmd=/tp @s ~ ~ ~ -90 -15"
      ],
      "off": [
        "pipe=fog:false"
      ],
      "on": [
        "pipe=fog:true"
      ],
