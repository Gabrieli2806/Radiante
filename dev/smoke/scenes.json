  "toggles": [
    {
      "name": "ray_tracing",
      "what": "Radiante's picture against Minecraft's own: they must differ.",
      "view": [
        "cmd=/radiante showcase 8"
      ],
      "off": [
        "rt=false"
      ],
      "on": [
        "rt=true"
      ],
      "settle_ticks": 120
    },
    {
      "name": "volumetric_fog",
      "what": "Light shafts and fog in the air.",
      "view": [
        "cmd=/radiante showcase 1",
        "cmd=/tp @s ~ ~ ~ -90 -15"
      ],
      "off": [
        "pipe=fog:false"
      ],
      "on": [
        "pipe=fog:true"
      ],
      "settle_ticks": 160,
      "min_difference": 0.15
    },
    {
      "name": "glowing_pixel_light",
      "what": "Light From Glowing Pixels on a lit redstone lamp, close: where the light starts on the block.",
      "view": [
        "cmd=/time set 18000",
        "cmd=/setblock 3018 199 32 minecraft:redstone_block",
        "cmd=/setblock 3018 200 32 minecraft:redstone_lamp[lit=true]",
        "cmd=/tp @s 3018.5 200 30.5 0 25"
      ],
      "off": [
        "opt=glowingPixelLight=false"
      ],
      "on": [
        "opt=glowingPixelLight=true"
      ],
      "settle_ticks": 260,
      "min_difference": 0.05
    }
  ]
