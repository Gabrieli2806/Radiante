        "cmd=/tp @s 3026.5 198 8.5 0 70"
      ],
      "settle_ticks": 140
    },
    {
      "name": "lamps_by_day",
      "what": "A torch, a campfire and a lantern under a roof by day: a warm pool of light round each in the shade, and their flames lit.",
      "actions": [
        "cmd=/time set 6000",
        "cmd=/tp @s 3007.5 200 18.5 0 20"
      ],
      "settle_ticks": 140
    },
    {
      "name": "lava_pool_night",
      "what": "A pool of lava at night: deep orange with its pattern, not a pale peach; the rim lit orange, not burnt white.",
      "actions": [
        "cmd=/kill @e[type=!player]",
        "cmd=/time set 18000",
        "cmd=/tp @s 3026.5 203 16.5 0 40"
