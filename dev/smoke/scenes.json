{
  "world": "RadianteSmokeSuite",
  "setup": [
    "hud=false",
    "cmd=/gamerule advance_time false",
    "cmd=/time set 6000",
    "cmd=/weather clear",
    "cmd=/tp @s ~ ~ ~ -90 5",
